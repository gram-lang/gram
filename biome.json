{
	"$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"packages/*/src/**",
			"packages/*/tests/**",
			"conformance/*.ts",
			"!**/*.gram",
			"!**/grammar-content.ts",
			"!**/*.svg",
			"!packages/*/src/public"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "warn",
				"noImplicitAnyLet": "off",
				"noControlCharactersInRegex": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/parser/src/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "error"
					}
				}
			}
		},
		{
			"includes": ["packages/cli/src/core/**", "packages/cli/src/services/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@clack/prompts": "core/ and services/ must return data, not perform display I/O — a previous @clack/prompts log.warn() here wrote to stdout and corrupted `gram build | jq` (audit 2026-07-22, cli finding B-3). Return the data/warnings and report them from the commands/ or ui/ layer instead."
								}
							}
						}
					}
				}
			}
		}
	],
	"assist": {
		"enabled": false
	}
}
