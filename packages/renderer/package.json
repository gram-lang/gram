{
  "name": "@gram-lang/renderer",
  "version": "1.2.1",
  "description": "Universal Markdown and HTML AST renderer for the Gram recipe language.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "gram.css",
    "gantt.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --tsconfig ../../tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test --only-failures",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "gram",
    "recipe",
    "renderer",
    "markdown",
    "html"
  ],
  "author": "abiwab",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://git.gram-lang.org/gram-lang/gram.git",
    "directory": "packages/renderer"
  },
  "bugs": {
    "url": "https://git.gram-lang.org/gram-lang/gram/issues"
  },
  "homepage": "https://git.gram-lang.org/gram-lang/gram/src/branch/main/packages/renderer#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@gram-lang/parser": "workspace:*",
    "@gram-lang/kitchen": "workspace:*",
    "@gram-lang/analyzer": "workspace:*",
    "@gram-lang/i18n": "workspace:*"
  },
  "type": "module"
}