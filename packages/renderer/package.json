{
  "name": "@gram/renderer",
  "version": "1.0.0-beta.0",
  "description": "Universal Markdown and HTML AST renderer for the Gram recipe language.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --tsconfig ../../tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "gram",
    "recipe",
    "renderer",
    "markdown",
    "html"
  ],
  "author": "abiwab",
  "license": "GPL-3.0",
  "dependencies": {
    "@gram/parser": "workspace:*",
    "@gram/kitchen": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "type": "module"
}