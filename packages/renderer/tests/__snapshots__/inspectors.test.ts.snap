"(Recipe
  (Object :title "Pancakes")
  (Section :title "Batter"
    (Step :action "Mix"
      (Text :value "Whisk ")
      (Ingredient :name "flour"
        (Quantity :unit "g" :fixed false
          (single :value 250 :text "250")))
      (Text :value "with ")
      (Ingredient :name "milk"
        (Quantity :unit "ml" :fixed false
          (single :value 500 :text "500")))
      (Text :value "and rest ")
      (Timer :isPassive true
        (Quantity :unit "h" :fixed false
          (range :value 1.5 :range 1-2 :text "1-2")))
      (Text :value "."))))"
`;

