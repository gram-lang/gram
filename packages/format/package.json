{
  "name": "@gram-lang/format",
  "version": "1.1.0",
  "description": "Canonical .gram source formatter, shared by the CLI and language server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "gram",
    "recipe",
    "formatter"
  ],
  "author": "abiwab",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://git.gram-lang.org/gram-lang/gram.git",
    "directory": "packages/format"
  },
  "bugs": {
    "url": "https://git.gram-lang.org/gram-lang/gram/issues"
  },
  "homepage": "https://git.gram-lang.org/gram-lang/gram/src/branch/main/packages/format#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --tsconfig ../../tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test --only-failures",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@gram-lang/parser": "workspace:*"
  },
  "type": "module"
}