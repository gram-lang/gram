{
  "name": "@gram-lang/cli",
  "version": "1.0.0-beta.3",
  "description": "CLI for the Gram recipe language",
  "type": "module",
  "files": [
    "dist"
  ],
  "keywords": [
    "gram",
    "recipe",
    "cli"
  ],
  "author": "abiwab",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/abiwab/gram.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://codeberg.org/abiwab/gram/issues"
  },
  "homepage": "https://codeberg.org/abiwab/gram/src/branch/main/packages/cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gram": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@clack/prompts": "^1.7.0",
    "@gram-lang/analyzer": "workspace:*",
    "@gram-lang/i18n": "workspace:*",
    "@gram-lang/kitchen": "workspace:*",
    "@gram-lang/parser": "workspace:*",
    "@gram-lang/renderer": "workspace:*",
    "ai": "^7.0.22",
    "chalk": "^5.6.2",
    "citty": "^0.2.2",
    "defu": "^6.1.7",
    "ink": "^7.1.0",
    "p-limit": "^7.3.0",
    "react": "^19.2.7",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17"
  }
}
