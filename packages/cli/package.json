{
  "name": "@gram/cli",
  "version": "1.0.0-beta.1",
  "description": "CLI for the Gram recipe language",
  "type": "module",
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "bin": {
    "gram": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "bun run src/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/google": "^3.0.83",
    "@ai-sdk/openai": "^3.0.73",
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@clack/prompts": "^1.6.0",
    "@gram/analyzer": "workspace:*",
    "@gram/i18n": "workspace:*",
    "@gram/kitchen": "workspace:*",
    "@gram/parser": "workspace:*",
    "@gram/renderer": "workspace:*",
    "ai": "^6.0.208",
    "chalk": "^5.4.0",
    "citty": "^0.2.2",
    "defu": "^6.1.7",
    "ink": "^7.1.0",
    "p-limit": "^7.3.0",
    "react": "^19.2.7",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}