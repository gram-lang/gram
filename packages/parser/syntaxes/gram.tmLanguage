		<key>timer-content</key>
		<dict>
			<key>comment</key>
			<string>A duration as written: 1h30, 1 hr 30 mins, 1:30 h, 5'30&quot;, 45 min - 1 h. Mirrors tokenizeDuration (@gram-lang/i18n): numbers, units in any script, primes, and the : + - signs.</string>
