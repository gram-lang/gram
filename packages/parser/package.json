{
  "name": "@gram/parser",
  "version": "1.0.0-beta.0",
  "description": "Core parser for the GRAM recipe language, converting .gram files to JSON AST.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./textmate": "./syntaxes/gram.tmLanguage.json"
  },
  "keywords": [
    "gram",
    "recipe",
    "parser",
    "ast"
  ],
  "author": "abiwab",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/abiwab/gram.git",
    "directory": "parser"
  },
  "bugs": {
    "url": "https://codeberg.org/abiwab/gram/issues"
  },
  "homepage": "https://codeberg.org/abiwab/gram/src/branch/main/packages/parser#readme",
  "scripts": {
    "prebuild": "node scripts/build-grammar.cjs",
    "build": "tsup src/index.ts --format esm --dts --tsconfig ../../tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ohm-js": "^17.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "type": "module"
}
