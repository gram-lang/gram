{
  "name": "@gram-lang/parser",
  "version": "1.2.0",
  "description": "Core parser for the Gram recipe language, converting .gram files to JSON AST.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./textmate": "./syntaxes/gram.tmLanguage.json"
  },
  "files": [
    "dist",
    "syntaxes"
  ],
  "keywords": [
    "gram",
    "recipe",
    "parser",
    "ast"
  ],
  "author": "abiwab",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://git.gram-lang.org/gram-lang/gram.git",
    "directory": "packages/parser"
  },
  "bugs": {
    "url": "https://git.gram-lang.org/gram-lang/gram/issues"
  },
  "homepage": "https://git.gram-lang.org/gram-lang/gram/src/branch/main/packages/parser#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node scripts/build-grammar.cjs",
    "build": "tsup src/index.ts --format esm --dts --tsconfig ../../tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test --only-failures",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ohm-js": "^17.5.0",
    "zod": "^4.4.3"
  },
  "type": "module"
}