{
  "name": "@gram-lang/analyzer",
  "version": "1.0.1",
  "description": "Gram recipe analyzer for physical properties (mass, yield, nutrition)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nutrients": {
      "types": "./dist/nutrients.d.ts",
      "import": "./dist/nutrients.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "gram",
    "recipe",
    "analyzer",
    "nutrition"
  ],
  "author": "abiwab",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://git.gram-lang.org/gram-lang/gram.git",
    "directory": "packages/analyzer"
  },
  "bugs": {
    "url": "https://git.gram-lang.org/gram-lang/gram/issues"
  },
  "homepage": "https://git.gram-lang.org/gram-lang/gram/src/branch/main/packages/analyzer#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/nutrients.ts --format esm --dts --tsconfig ../../tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@gram-lang/parser": "workspace:*",
    "@gram-lang/kitchen": "workspace:*",
    "@gram-lang/i18n": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  },
  "type": "module"
}
