{
  "name": "@gram/vscode-extension",
  "displayName": "Gram Language Support",
  "description": "Syntax highlighting and language intelligence for Gram recipe files",
  "version": "1.0.0-beta.0",
  "publisher": "abiwab",
  "license": "GPL-3.0",
  "author": "abiwab",
  "main": "./dist/extension.cjs",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/abiwab/gram.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://codeberg.org/abiwab/gram/issues"
  },
  "homepage": "https://codeberg.org/abiwab/gram/src/branch/main/packages/vscode-extension#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gram.showPreview",
        "title": "GRAM: Live Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "gram.showNutrition",
        "title": "GRAM: Macros"
      }
    ],
    "languages": [
      {
        "id": "gram",
        "aliases": [
          "Gram",
          "gram"
        ],
        "extensions": [
          ".gram"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gram",
        "scopeName": "source.gram",
        "path": "./dist/syntaxes/gram.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gram",
        "path": "./snippets/gram.json"
      }
    ],
    "configuration": {
      "title": "GRAM",
      "properties": {
        "gram.ingredientDatabase.path": {
          "type": "string",
          "default": "",
          "description": "Path to a YAML ingredient database file. Leave empty to auto-detect .gram/ingredients.yaml in the workspace root."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "gram",
        "scopes": {
          "namespace": [
            "entity.name.section.gram"
          ],
          "keyword": [
            "keyword.control.gram"
          ],
          "parameter": [
            "variable.parameter.ingredient.gram"
          ],
          "variable": [
            "variable.other.intermediate.gram"
          ],
          "number": [
            "constant.numeric.gram"
          ],
          "type": [
            "string.unquoted.unit.gram"
          ],
          "string": [
            "string.quoted.gram"
          ],
          "operator": [
            "keyword.operator.gram"
          ],
          "function": [
            "entity.name.function.action.gram"
          ],
          "comment": [
            "comment.line.gram"
          ]
        }
      }
    ]
  },
  "scripts": {
    "build": "node build.cjs",
    "dev": "node build.cjs --watch",
    "package": "vsce package"
  },
  "dependencies": {
    "@gram/language-server": "workspace:*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.5.0",
    "esbuild": "^0.25.5",
    "typescript": "^6.0.3"
  },
  "type": "module"
}
