{
  "name": "gram-lang",
  "displayName": "Gram - Recipe Language",
  "description": "Syntax highlighting and language intelligence for Gram recipe files",
  "version": "1.2.1",
  "private": true,
  "qna": false,
  "publisher": "gram-lang",
  "license": "GPL-3.0",
  "author": "gram-lang",
  "main": "./dist/extension.cjs",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://git.gram-lang.org/gram-lang/gram.git",
    "directory": "packages/vscode-extension"
  },
  "bugs": {
    "url": "https://git.gram-lang.org/gram-lang/gram/issues"
  },
  "homepage": "https://gram-lang.org/",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "gram",
    "recipe",
    "cooking",
    "language server",
    "syntax highlighting"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gram.showPreview",
        "title": "Gram: Live Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "gram.showNutrition",
        "title": "Gram: Macros",
        "icon": "$(symbol-numeric)"
      },
      {
        "command": "gram.showGantt",
        "title": "Gram: Gantt Chart",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gram.showPreview",
          "when": "resourceLangId == gram",
          "group": "navigation@1"
        },
        {
          "command": "gram.showGantt",
          "when": "resourceLangId == gram",
          "group": "navigation@2"
        },
        {
          "command": "gram.showNutrition",
          "when": "resourceLangId == gram",
          "group": "navigation@3"
        }
      ]
    },
    "languages": [
      {
        "id": "gram",
        "aliases": [
          "Gram",
          "gram"
        ],
        "extensions": [
          ".gram"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gram",
        "scopeName": "source.gram",
        "path": "./dist/syntaxes/gram.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gram",
        "path": "./snippets/gram.json"
      }
    ],
    "configuration": {
      "title": "Gram",
      "properties": {
        "gram.ingredientDatabase.path": {
          "type": "string",
          "default": "",
          "description": "Path to a YAML ingredient database file. Leave empty to auto-detect .gram/ingredients.yaml in the workspace root."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "gram",
        "scopes": {
          "namespace": [
            "entity.name.section.gram"
          ],
          "keyword": [
            "keyword.control.gram"
          ],
          "parameter": [
            "variable.parameter.ingredient.gram"
          ],
          "variable": [
            "variable.other.intermediate.gram"
          ],
          "number": [
            "constant.numeric.gram"
          ],
          "type": [
            "string.unquoted.unit.gram"
          ],
          "string": [
            "string.quoted.gram"
          ],
          "operator": [
            "keyword.operator.gram"
          ],
          "function": [
            "entity.name.function.action.gram"
          ],
          "comment": [
            "comment.line.gram"
          ]
        }
      }
    ]
  },
  "scripts": {
    "build": "node build.cjs",
    "typecheck": "tsc --noEmit",
    "dev": "node build.cjs --watch",
    "package": "bunx turbo run build --filter=gram-lang && vsce package --no-dependencies"
  },
  "dependencies": {
    "@gram-lang/language-server": "workspace:*",
    "@gram-lang/renderer": "workspace:*",
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1"
  },
  "type": "module"
}