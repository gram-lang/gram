{
  "name": "@gram-lang/docs",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "bunx --bun astro dev",
    "prebuild": "bun scripts/vendor-starlight-tokens.ts && bun scripts/generate-llms-full.ts",
    "build": "bunx --bun astro build && node scripts/check-bundle-size.mjs",
    "preview": "bunx --bun astro preview",
    "astro": "bunx --bun astro",
    "typecheck": "bunx --bun astro check && vue-tsc -p tsconfig.vue.json --noEmit"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/starlight": "^0.43.1",
    "@astrojs/vue": "^7.1.6",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@gram-lang/analyzer": "workspace:*",
    "@gram-lang/i18n": "workspace:*",
    "@gram-lang/kitchen": "workspace:*",
    "@gram-lang/modules": "workspace:*",
    "@gram-lang/parser": "workspace:*",
    "@gram-lang/renderer": "workspace:*",
    "@gram-lang/scheduler": "workspace:*",
    "astro": "^7.4.13",
    "mermaid": "^12.0.0",
    "shiki": "^4.3.1",
    "starlight-theme-nova": "^0.12.3",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.0.13",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/mdast": "^4.0.4",
    "starlight-links-validator": "^0.27.0",
    "vue-tsc": "^3.3.14",
    "yaml": "^2.9.0"
  }
}
