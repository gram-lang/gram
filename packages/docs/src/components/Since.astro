---
import { changelogAnchor } from "../lib/changelog-anchors";

export interface Props {
	v: "1.1.0" | "1.2.0" | string;
	type?: "added" | "changed" | "deprecated";
	href?: string;
	class?: string;
}

const { v, type = "added", href, class: className = "" } = Astro.props;

// Clean version string (e.g. "v1.1.0" -> "1.1.0")
const cleanVersion = v.replace(/^v/, "");
const formattedVersion = `v${cleanVersion}`;

// Detect locale (Astro / Starlight)
const pathname = Astro.url.pathname;
const isFrench =
	pathname.startsWith("/fr/") ||
	pathname === "/fr" ||
	Astro.currentLocale === "fr";

// Tooltip title descriptions
const tooltips = {
	fr: {
		added: `Ajouté en ${formattedVersion}`,
		changed: `Modifié en ${formattedVersion}`,
		deprecated: `Déprécié en ${formattedVersion}`,
	},
	en: {
		added: `Added in ${formattedVersion}`,
		changed: `Changed in ${formattedVersion}`,
		deprecated: `Deprecated in ${formattedVersion}`,
	},
};

const tooltipText =
	(isFrench ? tooltips.fr : tooltips.en)[type] || tooltips.en.added;
const releaseNoteHint = isFrench
	? "Voir les notes de version"
	: "View release notes";
const title = `${tooltipText} — ${releaseNoteHint}`;

// Automatic release note / changelog URL resolution
function getDefaultReleaseUrl(ver: string, fr: boolean): string {
	const prefix = fr ? "/fr" : "";
	if (ver === "1.1.0") {
		return `${prefix}/blog/2026-08-16-release-1.1.0`;
	}
	// Fallback to the release on the changelog page
	const anchor = changelogAnchor(ver);
	return `${prefix}/docs/changelog${anchor ? `#${anchor}` : ""}`;
}

const targetUrl = href || getDefaultReleaseUrl(cleanVersion, isFrench);
---

<a
	href={targetUrl}
	class:list={[
		"since-badge",
		`since-${type}`,
		className,
	]}
	title={title}
	aria-label={title}
>{formattedVersion}</a>

<style>
	/* Each variant only sets three tokens. The --sl-color-* scales flip with
	 * the theme (dark tint + light text in dark mode, light tint + dark text in
	 * light mode), so every pair keeps a readable contrast in both. */
	.since-badge {
		--since-border: var(--sl-color-accent);
		--since-bg: var(--sl-color-bg);
		--since-fg: var(--sl-color-text-accent);

		display: inline-flex;
		align-items: center;
		padding: 0.1rem 0.45rem;
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none !important;
		border-radius: 9999px;
		vertical-align: middle;
		font-family: var(--sl-font), system-ui, -apple-system, sans-serif;
		letter-spacing: 0.02em;
		cursor: pointer;
		margin-bottom: 0.5rem;
		border: 1px solid var(--since-border);
		background: var(--since-bg);
		/* !important: the generic `.sl-markdown-content a` rule (and its
		 * :hover) would otherwise repaint the text in the body colour. */
		color: var(--since-fg) !important;
	}

	.since-badge:hover {
		border-color: var(--since-fg);
	}

	.since-changed {
		--since-border: var(--sl-color-orange);
		--since-bg: var(--sl-color-orange-low);
		--since-fg: var(--sl-color-orange-high);
	}

	.since-deprecated {
		--since-border: var(--sl-color-red);
		--since-bg: var(--sl-color-red-low);
		--since-fg: var(--sl-color-red-high);
	}
</style>
