---
import { Code } from "astro:components";
import { Icon } from "@astrojs/starlight/components";

interface Props {
	id: string;
	active?: boolean;
	desc: string;
	link: string;
	learnMoreText: string;
	inputCode: string;
	outputCode: string;
	gramLang: any;
	codeThemes: Record<string, any>;
}

const {
	id,
	active = false,
	desc,
	link,
	learnMoreText,
	inputCode,
	outputCode,
	gramLang,
	codeThemes,
} = Astro.props;
---

<div class={`feature-panel${active ? " active" : ""}`} id={id}>
	<p class="feature-desc">
		{desc}
		<a href={link} class="learn-more-link" style="margin-left: 0.5rem;">
			{learnMoreText} &rarr;
		</a>
	</p>
	<div class="feature-columns">
		<div class="col-input">
			<div class="code-block">
				<div class="code-header">
					<span class="filename">input.gram</span>
				</div>
				<Code code={inputCode} lang={gramLang} themes={codeThemes} />
			</div>
		</div>
		<div class="col-arrow">
			<Icon name="right-arrow" class="arrow-icon" />
		</div>
		<div class="col-output">
			<div class="modern-output-pane">
				<div class="output-header">
					<div class="view-toggles pill-toggles">
						<button class="pill-btn active" data-view="preview">Preview</button>
						<button class="pill-btn" data-view="json">JSON</button>
					</div>
				</div>
				<div class="view-content preview-view active">
					<slot />
				</div>
				<div class="view-content json-view">
					<div class="code-block json-block">
						<Code code={outputCode} lang="json" themes={codeThemes} />
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.feature-panel {
		display: none;
		flex-direction: column;
	}

	.feature-panel.active {
		display: flex;
	}

	.feature-desc {
		text-align: center;
		font-size: 1.1rem;
		color: var(--sl-color-gray-3);
		max-width: 650px;
		margin: 0 auto 3rem auto;
		line-height: 1.6;
		text-wrap: balance;
	}

	.feature-columns {
		display: flex;
		gap: 1rem;
		align-items: stretch;
	}

	.col-arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--sl-color-gray-3);
	}

	.col-arrow :global(.arrow-icon) {
		width: 2rem;
		height: 2rem;
		transition: transform 0.3s ease;
	}

	@media (max-width: 768px) {
		.feature-columns {
			flex-direction: column;
			gap: 1rem;
		}
		.col-arrow {
			padding: 0.5rem 0;
		}
		.col-arrow :global(.arrow-icon) {
			transform: rotate(90deg);
		}
	}

	.col-input,
	.col-output {
		flex: 1;
		min-width: 0;
	}

	.code-block {
		border: 1px solid var(--sl-color-hairline);
		border-radius: 10px;
		overflow: hidden;
		font-size: 1rem;
		box-shadow: var(--shadow-elevation-medium);
	}

	.code-header {
		background-color: var(--sl-color-gray-7);
		border-bottom: 1px solid var(--sl-color-hairline);
		padding: 0.6rem 1rem;
	}

	.filename {
		color: var(--sl-color-white);
		font-family: var(--sl-font-mono);
		font-size: 0.85rem;
		font-weight: bold;
	}

	.code-block :global(pre) {
		margin: 0;
		padding: 1.5rem;
		overflow-x: auto;
		color: var(--sl-color-gray-1);
		line-height: 1.5;
	}

	.col-input .code-block {
		height: 100%;
	}

	.learn-more-link {
		display: inline-block;
		color: var(--sl-color-text-accent);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
	}
	.learn-more-link:hover {
		text-decoration: underline;
	}

	/* Output Pane */
	.modern-output-pane {
		background-color: var(--sl-color-black);
		border: 1px solid var(--sl-color-hairline);
		border-radius: 10px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		height: 100%;
		box-shadow: var(--shadow-elevation-medium);
	}

	.output-header {
		background-color: var(--sl-color-gray-7);
		border-bottom: 1px solid var(--sl-color-hairline);
		padding: 0.4rem 1rem;
		display: flex;
		justify-content: flex-end;
		align-items: center;
	}

	.pill-toggles {
		display: flex;
		background-color: var(--sl-color-bg);
		border-radius: 6px;
		padding: 3px;
		border: 1px solid var(--sl-color-hairline);
	}

	.pill-btn {
		background: transparent;
		border: none;
		color: var(--sl-color-text-accent);
		padding: 4px 1rem;
		font-size: 0.8rem;
		font-weight: 600;
		border-radius: 4px;
		cursor: pointer;
	}

	.pill-btn:hover {
		color: var(--sl-color-white);
	}

	.pill-btn.active {
		background-color: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}

	.view-content {
		display: none;
		flex: 1;
	}

	.view-content.active {
		display: block;
	}

	.json-view {
		padding: 0;
	}

	.json-block {
		border: none;
		box-shadow: none;
		border-radius: 0;
		height: 100%;
	}
	.json-block :global(pre) {
		border-radius: 0;
		margin: 0;
	}
</style>
