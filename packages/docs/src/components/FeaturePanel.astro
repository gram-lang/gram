---
import { Code } from "astro:components";
import Icon from "./Icon.astro";

interface Props {
	id: string;
	title?: string;
	desc: string;
	link: string;
	learnMoreText: string;
	inputCode: string;
	outputCode: string;
	gramLang: any;
	codeThemes: Record<string, any>;
}

const {
	id,
	title,
	desc,
	link,
	learnMoreText,
	inputCode,
	outputCode,
	gramLang,
	codeThemes,
} = Astro.props;
---

<div class="feature-panel" id={id}>
	<p class="feature-desc">
		{desc}
		<a href={link} class="learn-more-link" style="margin-left: 0.5rem;">
			{learnMoreText}{title && <span class="sr-only">: {title}</span>}<span aria-hidden="true"> &rarr;</span>
		</a>
	</p>
	<div class="feature-columns">
		<div class="col-input">
			<div class="code-block" role="region" aria-label="input.gram">
				<div class="code-header">
					<span class="filename">input.gram</span>
				</div>
				<Code code={inputCode} lang={gramLang} themes={codeThemes} />
			</div>
		</div>
		<div class="col-arrow" aria-hidden="true">
			<Icon name="right-arrow" class="arrow-icon" />
		</div>
		<div class="col-output">
			<div class="modern-output-pane">
				<div class="output-header">
					<div class="view-toggles pill-toggles" role="tablist" aria-label="Output format">
						<button
							type="button"
							role="tab"
							id={`${id}-tab-preview`}
							aria-controls={`${id}-view-preview`}
							aria-selected="true"
							class="pill-btn active"
							data-view="preview"
							tabindex="0"
						>Preview</button>
						<button
							type="button"
							role="tab"
							id={`${id}-tab-json`}
							aria-controls={`${id}-view-json`}
							aria-selected="false"
							class="pill-btn"
							data-view="json"
							tabindex="-1"
						>JSON</button>
					</div>
				</div>
				<div
					id={`${id}-view-preview`}
					role="tabpanel"
					aria-labelledby={`${id}-tab-preview`}
					class="view-content preview-view active"
					tabindex="0"
				>
					<slot />
				</div>
				<div
					id={`${id}-view-json`}
					role="tabpanel"
					aria-labelledby={`${id}-tab-json`}
					class="view-content json-view"
					tabindex="0"
					hidden
				>
					<div class="code-block json-block" role="region" aria-label="JSON Output">
						<Code
							code={outputCode}
							lang="json"
							themes={codeThemes}
						/>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.feature-panel {
		display: flex;
		flex-direction: column;
	}

	.feature-desc {
		font-size: 1.1rem;
		color: var(--sl-color-gray-3);
		margin-bottom: 1.5rem;
		line-height: 1.6;
		margin-top: 0;
	}

	.feature-columns {
		display: flex;
		gap: 1rem;
		align-items: stretch;
	}

	.col-arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--sl-color-gray-3);
	}

	.col-arrow :global(.arrow-icon) {
		width: 1.75rem !important;
		height: 1.75rem !important;
		transition: transform 0.3s ease;
	}

	@media (max-width: 768px) {
		.feature-columns {
			flex-direction: column;
			gap: 1rem;
		}
		.col-arrow {
			padding: 0.5rem 0;
		}
		.col-arrow :global(.arrow-icon) {
			transform: rotate(90deg);
		}
	}

	.col-input,
	.col-output {
		flex: 1;
		min-width: 0;
	}

	.code-block {
		border: 1px solid var(--sl-color-border);
		overflow: hidden;
		font-size: 0.9rem;
	}

	.code-header {
		background-color: var(--sl-color-gray-7);
		border-bottom: 1px solid var(--sl-color-border);
		padding: 0 1rem;
		height: 42px;
		display: flex;
		align-items: center;
	}

	.filename {
		color: var(--sl-color-white);
		font-family: var(--sl-font-mono);
		font-size: 0.85rem;
		font-weight: bold;
	}

	.code-block :global(pre) {
		margin: 0;
		padding: 1.5rem;
		overflow-x: auto;
		color: var(--sl-color-gray-1);
		line-height: 1.5;
	}

	.col-input .code-block {
		height: 100%;
	}

	.learn-more-link {
		display: inline-block;
		font-weight: 600;
		color: var(--sl-color-text);
		text-decoration: underline;
		text-decoration-color: var(--gram-orange);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}

	.learn-more-link:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 3px;
		border-radius: 2px;
	}

	/* Output Pane */
	.modern-output-pane {
		background-color: var(--sl-color-black);
		border: 1px solid var(--sl-color-border);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.output-header {
		background-color: var(--sl-color-gray-7);
		border-bottom: 1px solid var(--sl-color-border);
		padding: 0 1rem;
		display: flex;
		justify-content: flex-end;
		align-items: center;
		height: 42px;
	}

	.pill-toggles {
		display: flex;
		gap: 1rem;
	}

	.pill-btn {
		background: transparent;
		border: none;
		border-bottom: 2px solid transparent;
		color: var(--sl-color-gray-3);
		padding: 0.2rem 0;
		font-size: 0.8rem;
		font-weight: 600;
		cursor: pointer;
	}

	.pill-btn:hover {
		color: var(--sl-color-white);
	}

	.pill-btn:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 3px;
		border-radius: 2px;
	}

	.pill-btn.active {
		color: var(--sl-color-text);
		border-bottom-color: var(--sl-color-text-accent);
	}

	.view-content {
		display: none;
		flex: 1;
		background-color: var(--sl-color-bg);
	}

	.view-content:not([hidden]).active {
		display: block;
	}

	.json-view {
		padding: 0;
	}

	.json-block {
		border: none;
		box-shadow: none;
		border-radius: 0;
		height: 100%;
	}
	.json-block :global(pre) {
		border-radius: 0;
		margin: 0;
	}
</style>
