---
import Layout from "../layouts/Layout.astro";
import { Code } from "astro:components";
import Icon from "./Icon.astro";
import gramGrammar from "@gram-lang/parser/textmate";
import FeaturePanel from "./FeaturePanel.astro";
import { GRAM_VERSION } from "../lib/gram-version";
import { NUTRIENTS, type NutrientKey } from "@gram-lang/analyzer";
import { nutritionRows } from "@gram-lang/renderer";
import { getDictionary } from "@gram-lang/i18n";

const { lang, t } = Astro.props;
const gramLang = { ...gramGrammar, name: "gram" } as any;
const codeThemes: Record<string, any> = {
	light: "github-light",
	dark: "github-dark",
};

// The nutrition panel mockup below is a static picture of what the real
// renderer produces — it is not rendered by it. Driving its labels and their
// grouping from `nutritionGroups()` keeps the two from drifting apart.
const nutritionDict = getDictionary(lang);

// Per-portion figures for the Chantilly mockup: one quarter of a 259 g batch
// (240 g cream + 15 g powdered sugar + 4 g vanilla), the recipe shown in
// `nutritionInput`. Values match the renderer's own output.
const MOCK_PORTION_GRAMS = 259 / 4;
const MOCK_NUTRITION_VALUES: Partial<Record<NutrientKey, number>> = {
	calories: 220,
	fat: 21.6,
	carbs: 5.5,
	sugar: 5.5,
	fiber: 0,
	protein: 1.4,
	sodium: 11,
};
const per100Values = Object.fromEntries(
	Object.entries(MOCK_NUTRITION_VALUES).map(([k, v]) => [
		k,
		(v as number) * (100 / MOCK_PORTION_GRAMS),
	]),
);

// The rows come from the renderer, so the labels and their order follow the
// real table; the mockup is only its simplified picture (two columns, no %RI).
const round1 = (n: number) => Math.round(n * 10) / 10;
const portionRows = nutritionRows(MOCK_NUTRITION_VALUES as any, lang);
const per100Rows = nutritionRows(per100Values as any, lang);
const kcalPortion = Math.round(MOCK_NUTRITION_VALUES.calories ?? 0);
const kcal100 = Math.round(per100Values.calories ?? 0);
const kj = (kcal: number) => Math.round(kcal * 4.184);
const mockNutrientRows = portionRows
	.filter((r) => r.key !== "calories")
	.map((r) => ({
		label: r.label,
		nested: r.nested,
		portion: `${round1(r.value)} ${r.unit}`,
		per100: `${round1(per100Rows.find((x) => x.key === r.key)?.value ?? 0)} ${r.unit}`,
	}));
---

<Layout title="Gram" description={t.metaDescription} currentLang={lang}>
  <!-- Hero Section -->
  <section class="section hero" aria-labelledby="hero-heading">
    <div class="homepage-container">
      <div class="hero-layout">
        <div class="hero-text">
          <h1 class="title" id="hero-heading">{t.heroTitle}</h1>
          <p class="subtitle">{t.heroSubtitle}</p>
          <p class="description">
            {t.heroDescription}
          </p>

          <div class="actions">
            <a
              href={lang === "fr"
                ? "/fr/docs/explanation/philosophy"
                : "/docs/explanation/philosophy"}
              class="button primary">{t.heroGetStarted}</a
            >
            <a
              href={lang === "fr" ? "/fr/play" : "/play"}
              class="button secondary">{t.heroPlayground}</a
            >
          </div>

          <div class="version-badge">
            <a href={lang === "fr" ? "/fr/docs/changelog" : "/docs/changelog"}
              >Version {GRAM_VERSION}</a
            >
          </div>
        </div>

        <div class="hero-code">
          <div class="code-block" role="region" aria-label={t.recipeFileName || "recipe.gram"}>
            <div class="code-header">
              <span class="filename">{t.recipeFileName || "recipe.gram"}</span>
            </div>
            <Code code={t.recipeCode} lang={gramLang} themes={codeThemes} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section
    class="section philosophy alt-bg"
    aria-labelledby="philosophy-heading"
  >
    <div class="homepage-container">
      <h2 id="philosophy-heading">{t.whyGram}</h2>
      {t.whyGramDesc && <p class="section-desc">{t.whyGramDesc}</p>}
      <div class="grid">
        {
          t.philosophy.map(
            (item: {
              title: string;
              details: string;
              icon?: string;
              link?: string;
            }) => (
              <div class="grid-item">
                <div class="item-header">
                  {item.icon && (
                    <Icon name={item.icon as any} size="1.4rem" class="icon" />
                  )}
                  <h3>{item.title}</h3>
                </div>
                <p>{item.details}</p>
                {item.link && (
                  <a href={item.link} class="learn-more-link">
                    {t.learnMore}
                    <span class="sr-only">: {item.title}</span>
                    <span aria-hidden="true"> &rarr;</span>
                  </a>
                )}
              </div>
            ),
          )
        }
      </div>
    </div>
  </section>

  <!-- Use Cases with Vanilla Tabs -->
  <section class="section use-cases" aria-labelledby="use-cases-heading">
    <div class="homepage-container">
      <h2 id="use-cases-heading">{t.discoverGram}</h2>
      <p class="section-desc">
        {t.discoverDesc}
      </p>

      <div class="modern-features-container">
        <!-- Content Area -->
        <div class="features-content">
          <!-- Feature: Nutrition -->
          <details class="feature-accordion" open>
            <summary class="feature-summary">
              <h3 class="feature-title">{t.tabNutritionTitle}</h3>
            </summary>
            <FeaturePanel
              id="feature-nutrition"
              title={t.tabNutritionTitle}
              desc={t.tabNutritionDesc}
              link={t.tabNutritionLink}
              learnMoreText={t.learnMore}
              inputCode={t.nutritionInput}
              outputCode={t.nutritionOutput}
              gramLang={gramLang}
              codeThemes={codeThemes}
            >
              <div class="modern-mockup-card nut-card-mock" role="region" aria-label={nutritionDict.renderer.nutritionTableTitle}>
                <ul class="kit-mock">
                  <li>
                    <span class="kit-mock-name">{lang === "fr" ? "crème liquide" : "heavy cream"}</span>
                    <span class="kit-mock-qty"><span class="kit-mock-orig">{lang === "fr" ? "1 tasse" : "1 cup"}</span><strong>240 g</strong></span>
                  </li>
                  <li>
                    <span class="kit-mock-name">{lang === "fr" ? "sucre glace" : "powdered sugar"}</span>
                    <span class="kit-mock-qty"><span class="kit-mock-orig">{lang === "fr" ? "2 c.à.s" : "2 tbsp"}</span><strong>15 g</strong></span>
                  </li>
                  <li>
                    <span class="kit-mock-name">{lang === "fr" ? "extrait de vanille" : "vanilla extract"}</span>
                    <span class="kit-mock-qty"><span class="kit-mock-orig">{lang === "fr" ? "1 c.à.c" : "1 tsp"}</span><strong>4 g</strong></span>
                  </li>
                </ul>
                <div class="nut-panel-mock">
                  <div class="nut-header-mock">
                    <strong>{nutritionDict.renderer.nutritionTableTitle}</strong>
                    <span>{nutritionDict.renderer.estimateTooltip}</span>
                  </div>
                  <table class="nut-table-mock">
                    <thead>
                      <tr>
                        <th scope="col"><span class="sr-only">{nutritionDict.renderer.nutritionNutrient}</span></th>
                        <th scope="col">{nutritionDict.renderer.nutritionPerPortion}</th>
                        <th scope="col">{nutritionDict.renderer.nutritionPer100g}</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr class="nut-energy-mock">
                        <th scope="row">{nutritionDict.renderer.nutrients.calories}</th>
                        <td><span class="kcal">{kcalPortion} kcal</span><span class="kj">{kj(kcalPortion)} kJ</span></td>
                        <td><span class="kcal">{kcal100} kcal</span><span class="kj">{kj(kcal100)} kJ</span></td>
                      </tr>
                      {
                        mockNutrientRows.map((row) => (
                          <tr class:list={{ nested: row.nested }}>
                            <th scope="row">{row.label}</th>
                            <td>{row.portion}</td>
                            <td>{row.per100}</td>
                          </tr>
                        ))
                      }
                    </tbody>
                  </table>
                </div>
              </div>
            </FeaturePanel>
          </details>

          <!-- Feature: Schedule -->
          <details class="feature-accordion">
            <summary class="feature-summary">
              <h3 class="feature-title">{t.tabScheduleTitle}</h3>
            </summary>
            <FeaturePanel
              id="feature-schedule"
              title={t.tabScheduleTitle}
              desc={t.tabScheduleDesc}
              link={t.tabScheduleLink}
              learnMoreText={t.learnMore}
              inputCode={t.scheduleInput}
              outputCode={t.scheduleOutput}
              gramLang={gramLang}
              codeThemes={codeThemes}
            >
              <div
                class="modern-mockup-card timeline-mockup-card"
                role="region"
                aria-label={nutritionDict.renderer.outputs.runSheet}
              >
                <div class="sr-only">
                  {lang === "fr"
                    ? "Plan de marche de la tarte au citron servie le samedi 21 novembre à 20 h. Vendredi : un passage en cuisine à 19 h 50 pour la pâte, qui repose au frais. Samedi : un passage à 19 h 40 pour la tarte, puis service à 20 h."
                    : "Run sheet for the lemon tart served Saturday, November 21 at 8 p.m. Friday: a visit to the kitchen at 7:50 p.m. for the dough, which rests in the fridge. Saturday: a visit at 7:40 p.m. for the tart, then serving at 8 p.m."}
                </div>
                <div class="plan-mock" aria-hidden="true">
                  <h4 class="plan-mock-title">{lang === "fr" ? "Tarte au citron" : "Lemon Tart"}</h4>
                  <p class="plan-mock-subtitle">{lang === "fr" ? "Pour le samedi 21 novembre à 20:00" : "For Saturday, November 21 at 20:00"}</p>
                  <p class="plan-mock-summary">{lang === "fr" ? "2 jours · 2 passages en cuisine · 35min de travail en tout" : "2 days · 2 visits to the kitchen · 35min of work in all"}</p>
                  <div class="plan-mock-schedule">
                    <div class="plan-mock-group">
                      <div class="plan-mock-day">{lang === "fr" ? "VEN." : "FRI"}<small>20</small></div>
                      <div class="plan-mock-rows">
                        <div class="plan-mock-row plan-mock-visit">
                          <span class="plan-mock-time">■ 19:50 – 20:00</span>
                          <span>{lang === "fr" ? "Pâte" : "Dough"}</span>
                        </div>
                        <div class="plan-mock-row plan-mock-thread">
                          <span class="plan-mock-time"><i></i></span>
                          <span>{lang === "fr" ? "Pâte : Reposer 8h à 1j" : "Dough : Chill 8h to 1d"}</span>
                        </div>
                      </div>
                    </div>
                    <div class="plan-mock-group">
                      <div class="plan-mock-day">{lang === "fr" ? "SAM." : "SAT"}<small>21</small></div>
                      <div class="plan-mock-rows">
                        <div class="plan-mock-row plan-mock-visit">
                          <span class="plan-mock-time">■ 19:40 – 20:00</span>
                          <span>{lang === "fr" ? "Tarte" : "Tart"}</span>
                        </div>
                        <div class="plan-mock-row plan-mock-serve">
                          <span class="plan-mock-time">★ 20:00</span>
                          <span>{lang === "fr" ? "Servir" : "Serve"}</span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <p class="plan-mock-legend"><span>■ {nutritionDict.renderer.runSheetLegendCook}</span><span>┆ {nutritionDict.renderer.runSheetLegendThread}</span></p>
                </div>
              </div>
            </FeaturePanel>
          </details>

          <!-- Feature: Modules -->
          <details class="feature-accordion">
            <summary class="feature-summary">
              <h3 class="feature-title">{t.tabModulesTitle}</h3>
            </summary>
            <FeaturePanel
              id="feature-modules"
              title={t.tabModulesTitle}
              desc={t.tabModulesDesc}
              link={t.tabModulesLink}
              learnMoreText={t.learnMore}
              inputCode={t.modulesInput}
              outputCode={t.modulesOutput}
              gramLang={gramLang}
              codeThemes={codeThemes}
            >
              <div class="modern-mockup-card rendered-recipe-mock" role="region" aria-label={lang === "fr" ? "Recette modulaire assemblée" : "Composed modular recipe"}>
                <!-- Section 1 : Base importée (inlinée et mise à l'échelle) -->
                <div class="rendered-section">
                  <div class="rendered-section-header">
                    <h4>{lang === "fr" ? "Pâte Sablée" : "Crust"}</h4>
                    <span class="rendered-module-badge">
                      📦 {lang === "fr" ? "bases/pate-sablee.gram" : "bases/shortcrust.gram"} &rarr; {lang === "fr" ? "pâte" : "crust"} (×0.5)
                    </span>
                  </div>
                  <ol class="gram-steps">
                    <li>
                      <span class="action">{lang === "fr" ? "Sabler" : "Mix"}</span>
                      {lang === "fr" ? "La " : "The "}<strong
                        >{lang === "fr" ? "farine" : "flour"}</strong
                      > (125g), {lang === "fr" ? "le " : ""}<strong
                        >{lang === "fr" ? "beurre" : "butter"}</strong
                      > (62.5g), {lang === "fr" ? "le " : ""}<strong
                        >{lang === "fr" ? "sucre glace" : "powdered sugar"}</strong
                      > (45g){lang === "fr" ? " et l'" : ", and "}<strong
                        >{lang === "fr" ? "eau" : "water"}</strong
                      > (17.5g).
                    </li>
                  </ol>
                </div>

                <!-- Section 2 : Recette hôte -->
                <div class="rendered-section">
                  <div class="rendered-section-header">
                    <h4>{lang === "fr" ? "Tarte Citron" : "Lemon Tart"}</h4>
                  </div>
                  <ol class="gram-steps" start="2">
                    <li>
                      <span class="action">{lang === "fr" ? "Foncer" : "Line"}</span>
                      {lang === "fr" ? "Le cercle à tarte avec la " : "The tart ring with "}<strong
                        >{lang === "fr" ? "pâte" : "&crust"}</strong
                      > (250g).
                    </li>
                    <li>
                      <span class="action">{lang === "fr" ? "Cuire" : "Bake"}</span>
                      {lang === "fr" ? "Au four pendant " : "Blind bake for "}<strong>18min</strong> {lang === "fr" ? "à " : "at "}<strong>175°C</strong>.
                    </li>
                    <li>
                      <span class="action">{lang === "fr" ? "Garnir" : "Fill"}</span>
                      {lang === "fr" ? "Verser le " : "Pour in the "}<strong
                        >{lang === "fr" ? "crémeux citron" : "lemon curd"}</strong
                      > (300g).
                    </li>
                  </ol>
                </div>
              </div>
            </FeaturePanel>
          </details>

          <!-- Feature: Scale -->
          <details class="feature-accordion">
            <summary class="feature-summary">
              <h3 class="feature-title">{t.tabScaleTitle}</h3>
            </summary>
            <FeaturePanel
              id="feature-scale"
              title={t.tabScaleTitle}
              desc={t.tabScaleDesc}
              link={t.tabScaleLink}
              learnMoreText={t.learnMore}
              inputCode={t.scaleInput}
              outputCode={t.scaleOutput}
              gramLang={gramLang}
              codeThemes={codeThemes}
            >
              <table class="modern-mockup-card tabular-mockup">
                <caption class="sr-only">
                  {lang === "fr" ? "Pourcentages du boulanger pour la recette" : "Baker's percentages for the recipe"}
                </caption>
                <thead>
                  <tr class="sr-only">
                    <th scope="col">{lang === "fr" ? "Ingrédient et poids" : "Ingredient and weight"}</th>
                    <th scope="col">{lang === "fr" ? "Pourcentage" : "Percentage"}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="tab-row reference-row">
                    <td class="tab-name"
                      ><strong
                        >{lang === "fr" ? "Farine T65" : "Bread Flour"}</strong
                      > - 400g</td
                    >
                    <td class="tab-val tab-val-ref">100%</td>
                  </tr>
                  <tr class="tab-row reference-row">
                    <td class="tab-name"
                      ><strong
                        >{
                          lang === "fr" ? "Farine Complète" : "Whole Wheat"
                        }</strong
                      > - 100g</td
                    >
                    <td class="tab-val">25%</td>
                  </tr>
                  <tr class="tab-row">
                    <td class="tab-name"
                      ><strong>{lang === "fr" ? "Eau" : "Water"}</strong> - 375g</td
                    >
                    <td class="tab-val">75%</td>
                  </tr>
                  <tr class="tab-row">
                    <td class="tab-name"
                      ><strong>{lang === "fr" ? "Levain" : "Levain"}</strong> - 100g</td
                    >
                    <td class="tab-val">20%</td>
                  </tr>
                  <tr class="tab-row">
                    <td class="tab-name"
                      ><strong>{lang === "fr" ? "Sel" : "Salt"}</strong> - 10g</td
                    >
                    <td class="tab-val">2%</td>
                  </tr>
                </tbody>
              </table>
            </FeaturePanel>
          </details>
        </div>
      </div>

      <div class="try-playground-container">
        <a href={lang === "fr" ? "/fr/play" : "/play"} class="button primary">
          {t.tryPlaygroundBtn || "Try it in the Playground"}
        </a>
      </div>
    </div>
  </section>

  <!-- Get Involved -->
  <section
    class="section get-involved alt-bg"
    aria-labelledby="get-involved-heading"
  >
    <div class="homepage-container">
      <h2 id="get-involved-heading">{t.getInvolved}</h2>
      <div class="grid involved-grid">
        <div class="grid-item card">
          <h3>{t.readBookTitle}</h3>
          <p>
            {t.readBookDesc}
          </p>
          <a
            href={lang === "fr"
              ? "/fr/docs/explanation/philosophy"
              : "/docs/explanation/philosophy"}
            class="link-btn"
            >{t.readBookLink}<span class="sr-only">: {t.readBookTitle}</span><span aria-hidden="true"> &rarr;</span></a
          >
        </div>
        <div class="grid-item card">
          <h3>{t.contributeTitle}</h3>
          <p>
            {t.contributeDesc}
          </p>
          <a href="https://git.gram-lang.org/gram-lang/gram" class="link-btn"
            >{t.contributeLink}<span class="sr-only">: {t.contributeTitle}</span><span aria-hidden="true"> &rarr;</span></a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Getting Started -->
  <section
    class="section getting-started"
    aria-labelledby="getting-started-heading"
  >
    <div class="homepage-container">
      <h2 id="getting-started-heading" style="margin-bottom: 1rem;">
        {t.tryTitle}
      </h2>
      <p
        style="margin-bottom: 2rem; color: var(--sl-color-gray-3); font-size: 1.1rem; text-wrap: balance;"
      >
        {t.tryDesc}
      </p>
      <div class="terminal-mini" role="region" aria-label={lang === "fr" ? "Commande d'initialisation CLI" : "CLI initialization command"}>
        <code id="cli-init-cmd"
          ><span class="prompt" aria-hidden="true">$</span> npx @gram-lang/cli init</code
        >
        <button
          type="button"
          class="copy-cmd-btn"
          aria-label={lang === "fr" ? "Copier la commande d'initialisation dans le presse-papiers" : "Copy initialization command to clipboard"}
          data-umami-event="copy-cli-init-command"
        >
          <span class="copy-label" aria-hidden="true">Copy</span>
          <span class="sr-only" aria-live="polite" id="copy-status"></span>
        </button>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Preview/JSON toggles and copy-to-clipboard
  import { trackEvent } from "../lib/umami";

  document.addEventListener("DOMContentLoaded", () => {
    // Preview/JSON Toggle Logic with ARIA tabs and keyboard support
    const featurePanels = document.querySelectorAll<HTMLElement>(".feature-panel");
    featurePanels.forEach((panel) => {
      const toggleBtns = Array.from(panel.querySelectorAll<HTMLButtonElement>(".pill-btn"));
      const viewContents = Array.from(panel.querySelectorAll<HTMLElement>(".view-content"));

      const switchTab = (btn: HTMLButtonElement) => {
        const viewType = btn.getAttribute("data-view");
        toggleBtns.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle("active", isActive);
          b.setAttribute("aria-selected", isActive ? "true" : "false");
          b.setAttribute("tabindex", isActive ? "0" : "-1");
        });

        viewContents.forEach((vc) => {
          const isTarget = vc.classList.contains(`${viewType}-view`);
          vc.classList.toggle("active", isTarget);
          if (isTarget) {
            vc.removeAttribute("hidden");
          } else {
            vc.setAttribute("hidden", "");
          }
        });

        trackEvent("homepage-feature-view", { feature: panel.id, view: viewType });
      };

      toggleBtns.forEach((btn, index) => {
        btn.addEventListener("click", () => switchTab(btn));

        btn.addEventListener("keydown", (e) => {
          let targetIndex = -1;
          if (e.key === "ArrowRight") {
            targetIndex = (index + 1) % toggleBtns.length;
          } else if (e.key === "ArrowLeft") {
            targetIndex = (index - 1 + toggleBtns.length) % toggleBtns.length;
          } else if (e.key === "Home") {
            targetIndex = 0;
          } else if (e.key === "End") {
            targetIndex = toggleBtns.length - 1;
          }

          if (targetIndex !== -1) {
            e.preventDefault();
            toggleBtns[targetIndex].focus();
            switchTab(toggleBtns[targetIndex]);
          }
        });
      });
    });

    // Copy Command Logic with Screen Reader feedback
    const copyBtn = document.querySelector<HTMLButtonElement>(".copy-cmd-btn");
    const copyLabel = copyBtn?.querySelector<HTMLElement>(".copy-label");
    const copyStatus = document.getElementById("copy-status");
    if (copyBtn && copyLabel) {
      const defaultText = copyLabel.textContent || "Copy";
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText("npx @gram-lang/cli init");
          copyLabel.textContent = "Copied";
          if (copyStatus) {
            copyStatus.textContent = document.documentElement.lang === "fr"
              ? "Commande copiée dans le presse-papiers"
              : "Command copied to clipboard";
          }
          setTimeout(() => {
            copyLabel.textContent = defaultText;
            if (copyStatus) copyStatus.textContent = "";
          }, 2000);
        } catch (err) {
          console.error("Failed to copy!", err);
        }
      });
    }
  });
</script>

<style>
  /* Ensure code blocks in feature cards stretch to full container height */
  :global(.feature-card .astro-code),
  :global(.code-snippet-box .astro-code) {
    height: 100%;
  }

  /* Base Container */
  .section {
    padding: 5rem 1.5rem;
  }
  .alt-bg {
    background-color: var(--sl-color-bg-nav);
  }
  .homepage-container {
    max-width: 1152px;
    margin: 0 auto;
    font-family: var(--sl-font);
    color: var(--sl-color-text);
  }

  /* Typography & Basics */
  h1,
  h2,
  h3,
  h4 {
    color: var(--sl-color-white);
    font-weight: 600;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  h2 {
    font-size: 2.2rem;
    position: relative;
    margin-bottom: 0.85rem;
  }

  /* Subtle color accent on headers */
  /* h2::before {
    content: "";
    position: absolute;
    left: 0;
    top: 10%;
    height: 80%;
    width: 4px;
    background-color: var(--sl-color-accent-high, var(--sl-color-text-accent));
    border-radius: 2px;
  } */

  pre,
  code {
    font-family: var(--sl-font-mono);
    font-variant-ligatures: none;
    font-size: 0.9em;
  }

  /* Syntax Highlighting overrides for hero/tabs */
  .comment {
    color: var(--sl-color-gray-3);
  }
  .keyword {
    color: #ff7b72;
    font-weight: 500;
  }
  .tag {
    color: #79c0ff;
  }

  /* Hero Section */
  .hero-layout {
