---
import Layout from "../layouts/Layout.astro";
import { Code } from "astro:components";
import { Icon } from "@astrojs/starlight/components";
import gramGrammar from "@gram-lang/parser/textmate";

const { lang, t } = Astro.props;
const gramLang = { ...gramGrammar, name: "gram" } as any;
const codeThemes = { light: "github-light", dark: "github-dark" };
---

<Layout title="Gram" currentLang={lang}>
  <!-- Hero Section -->
  <section class="section hero">
    <div class="homepage-container">
      <div class="hero-layout">
        <div class="hero-text">
          <h1 class="title">{t.heroTitle}</h1>
          <p class="subtitle">{t.heroSubtitle}</p>
          <p class="description">
            {t.heroDescription}
          </p>

          <div class="actions">
            <a
              href={lang === "fr"
                ? "/fr/docs/explanation/philosophy"
                : "/docs/explanation/philosophy"}
              class="button primary">{t.heroGetStarted}</a
            >
            <a
              href={lang === "fr" ? "/fr/play" : "/play"}
              class="button secondary">{t.heroPlayground}</a
            >
          </div>

          <div class="version-badge">
            <a href={lang === "fr" ? "/fr/docs/changelog" : "/docs/changelog"}
              >{t.versionText}</a
            >
          </div>
        </div>

        <div class="hero-code">
          <div class="code-block">
            <div class="code-header">
              <span class="filename">{t.recipeFileName || "recipe.gram"}</span>
            </div>
            <Code code={t.recipeCode} lang={gramLang} themes={codeThemes} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="section philosophy alt-bg">
    <div class="homepage-container">
      <h2>{t.whyGram}</h2>
      {
        t.whyGramDesc && (
          <p class="section-desc" style="margin-top: -0.5rem;">
            {t.whyGramDesc}
          </p>
        )
      }
      <div class="grid">
        {
          t.philosophy.map(
            (item: {
              title: string;
              details: string;
              icon?: string;
              link?: string;
            }) => (
              <div class="grid-item">
                <div class="item-header">
                  {item.icon && (
                    <Icon name={item.icon as any} size="1.4rem" class="icon" />
                  )}
                  <h3>{item.title}</h3>
                </div>
                <p>{item.details}</p>
                {item.link && (
                  <a href={item.link} class="learn-more-link">
                    {t.learnMore} &rarr;
                  </a>
                )}
              </div>
            ),
          )
        }
      </div>
    </div>
  </section>

  <!-- Use Cases with Vanilla Tabs -->
  <section class="section use-cases">
    <div class="homepage-container">
      <h2>{t.discoverGram}</h2>
      <p class="section-desc">
        {t.discoverDesc}
      </p>

      <div class="modern-features-container">
        <!-- Horizontal Tabs -->
        <div class="features-tabs">
          <button
            class="feature-tab-btn active"
            data-target="feature-nutrition"
          >
            {t.tabNutritionTitle}
          </button>
          <button class="feature-tab-btn" data-target="feature-schedule">
            {t.tabScheduleTitle}
          </button>
          <button class="feature-tab-btn" data-target="feature-scale">
            {t.tabScaleTitle}
          </button>
        </div>

        <!-- Content Area -->
        <div class="features-content">
          <!-- Feature: Nutrition -->
          <div class="feature-panel active" id="feature-nutrition">
            <p class="feature-desc">
              {t.tabNutritionDesc}
              <a
                href={t.tabNutritionLink}
                class="learn-more-link"
                style="margin-left: 0.5rem;"
              >
                {t.learnMore} &rarr;
              </a>
            </p>
            <div class="feature-columns">
              <div class="col-input">
                <div class="code-block">
                  <div class="code-header">
                    <span class="filename">input.gram</span>
                  </div>
                  <Code
                    code={t.nutritionInput}
                    lang={gramLang}
                    themes={codeThemes}
                  />
                </div>
              </div>
              <div class="col-arrow">
                <Icon name="right-arrow" class="arrow-icon" />
              </div>
              <div class="col-output">
                <div class="modern-output-pane">
                  <div class="output-header">
                    <div class="view-toggles pill-toggles">
                      <button class="pill-btn active" data-view="preview"
                        >Preview</button
                      >
                      <button class="pill-btn" data-view="json">JSON</button>
                    </div>
                  </div>
                  <div class="view-content preview-view active">
                    <div class="modern-mockup-card nut-card-mock">
                      <div class="mockup-steps">
                        <ol class="gram-steps">
                          <li>
                            <span class="action"
                              >{lang === "fr" ? "Fouetter" : "Whisk"}</span
                            >
                            {lang === "fr" ? "la " : ""}<strong
                              >{
                                lang === "fr" ? "crème liquide" : "heavy cream"
                              }</strong
                            > (240g)
                            {lang === "fr" ? "et le " : " and "}
                            <strong
                              >{
                                lang === "fr" ? "sucre glace" : "powdered sugar"
                              }</strong
                            > (25g)
                            {
                              lang === "fr"
                                ? " jusqu'à obtenir des pics souples."
                                : " until soft peaks form."
                            }
                          </li>
                          <li>
                            <span class="action"
                              >{lang === "fr" ? "Incorporer" : "Fold"}</span
                            >
                            {
                              lang === "fr"
                                ? "Ajouter délicatement l'"
                                : "Gently incorporate "
                            }<strong
                              >{
                                lang === "fr"
                                  ? "extrait de vanille"
                                  : "vanilla extract"
                              }</strong
                            > (4g).
                          </li>
                        </ol>
                      </div>
                      <div class="nut-panel-mock">
                        <div class="nut-header-mock">
                          Nutrition <span>EST.</span>
                        </div>
                        <div class="nut-grid-mock">
                          <div class="nut-item-mock">
                            <span class="label">Calories</span><strong
                              >925 kcal</strong
                            >
                          </div>
                          <div class="nut-item-mock">
                            <span class="label">Carbs</span><strong>26 g</strong
                            >
                          </div>
                          <div class="nut-item-mock">
                            <span class="label">Fat</span><strong>88 g</strong>
                          </div>
                          <div class="nut-item-mock">
                            <span class="label">Protein</span><strong
                              >6 g</strong
                            >
                          </div>
                          <div class="nut-item-mock">
                            <span class="label"
                              >{lang === "fr" ? "Sucres" : "Sugar"}</span
                            ><strong>25 g</strong>
                          </div>
                          <div class="nut-item-mock">
                            <span class="label"
                              >{lang === "fr" ? "Fibres" : "Fiber"}</span
                            ><strong>0 g</strong>
                          </div>
                          <div class="nut-item-mock">
                            <span class="label">Sodium</span><strong
                              >42 mg</strong
                            >
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="view-content json-view">
                    <div class="code-block json-block">
                      <Code
                        code={t.nutritionOutput}
                        lang="json"
                        themes={codeThemes}
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Feature: Schedule -->
          <div class="feature-panel" id="feature-schedule">
            <p class="feature-desc">
              {t.tabScheduleDesc}
              <a
                href={t.tabScheduleLink}
                class="learn-more-link"
                style="margin-left: 0.5rem;"
              >
                {t.learnMore} &rarr;
              </a>
            </p>
            <div class="feature-columns">
              <div class="col-input">
                <div class="code-block">
                  <div class="code-header">
                    <span class="filename">input.gram</span>
                  </div>
                  <Code
                    code={t.scheduleInput}
                    lang={gramLang}
                    themes={codeThemes}
                  />
                </div>
              </div>
              <div class="col-arrow">
                <Icon name="right-arrow" class="arrow-icon" />
              </div>
              <div class="col-output">
                <div class="modern-output-pane">
                  <div class="output-header">
                    <div class="view-toggles pill-toggles">
                      <button class="pill-btn active" data-view="preview"
                        >Preview</button
                      >
                      <button class="pill-btn" data-view="json">JSON</button>
                    </div>
                  </div>
                  <div class="view-content preview-view active">
                    <div class="modern-mockup-card timeline-mockup-card">
                      <div class="gantt-header-mock">
                        <span
                          >{lang === "fr" ? "Temps Total" : "Total Time"}: <strong
                            >17m</strong
                          ></span
                        >
                        <span
                          >{lang === "fr" ? "Actif" : " · Active"}: <strong
                            >7m</strong
                          ></span
                        >
                      </div>
                      <div class="gantt-tracks-container">
                        <div class="gantt-track-mock" style="height: 120px;">
                          <div class="track-label-mock">
                            {lang === "fr" ? "Actions" : "Actions"}
                          </div>
                          <div class="track-content-mock">
                            <div
                              class="time-block-mock passive-mock"
                              style="width: 26%; left: 0; top: 8px; border: none;"
                            >
                              <span
                                style="position: absolute; left: calc(100% + 10px); color: var(--sl-color-white); font-size: 0.85rem; font-weight: 600; white-space: nowrap;"
                                >Prep Time</span
                              >
                            </div>
                            <div
                              class="time-block-mock active-mock"
                              style="width: 26%; left: 52%; top: 44px;"
                            >
                              <span
                                style="position: absolute; left: calc(100% + 10px); color: var(--sl-color-white); font-size: 0.85rem; font-weight: 600; white-space: nowrap;"
                                >{lang === "fr" ? "Sauté" : "Sauté"}</span
                              >
                            </div>
                            <div
                              class="time-block-mock active-mock"
                              style="width: 10%; left: 78%; top: 80px;"
                            >
                              <span
                                style="position: absolute; left: calc(100% + 10px); color: var(--sl-color-white); font-size: 0.85rem; font-weight: 600; white-space: nowrap;"
                                >↳ {lang === "fr" ? "Mélanger" : "Toss"}</span
                              >
                            </div>
                          </div>
                        </div>
                        <div class="gantt-track-mock">
                          <div class="track-label-mock">
                            {lang === "fr" ? "Bouillir" : "Boiling"}
                          </div>
                          <div class="track-content-mock">
                            <div
                              class="time-block-mock passive-mock"
                              style="width: 52%; left: 26%;"
                            >
                              <span class="block-label-mock">10m</span>
                            </div>
                          </div>
                        </div>
                        <div
                          class="gantt-track-mock"
                          style="height: 36px; border-bottom: none;"
                        >
                          <div
                            class="track-label-mock"
                            style="border-right: none;"
                          >
                          </div>
                          <div
                            class="track-content-mock"
                            style="position: relative;"
                          >
                            <div class="gantt-tick" style="left: 0%;">0m</div>
                            <div class="gantt-tick" style="left: 26%;">5m</div>
                            <div class="gantt-tick" style="left: 52%;">10m</div>
                            <div class="gantt-tick" style="left: 78%;">15m</div>
                            <div class="gantt-tick" style="left: 88%;">17m</div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="view-content json-view">
                    <div class="code-block json-block">
                      <Code
                        code={t.scheduleOutput}
                        lang="json"
                        themes={codeThemes}
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Feature: Scale -->
          <div class="feature-panel" id="feature-scale">
            <p class="feature-desc">
              {t.tabScaleDesc}
              <a
                href={t.tabScaleLink}
                class="learn-more-link"
                style="margin-left: 0.5rem;"
              >
                {t.learnMore} &rarr;
              </a>
            </p>
            <div class="feature-columns">
              <div class="col-input">
                <div class="code-block">
                  <div class="code-header">
                    <span class="filename">input.gram</span>
                  </div>
                  <Code
                    code={t.scaleInput}
                    lang={gramLang}
                    themes={codeThemes}
                  />
                </div>
              </div>
              <div class="col-arrow">
                <Icon name="right-arrow" class="arrow-icon" />
              </div>
              <div class="col-output">
                <div class="modern-output-pane">
                  <div class="output-header">
                    <div class="view-toggles pill-toggles">
                      <button class="pill-btn active" data-view="preview"
                        >Preview</button
                      >
                      <button class="pill-btn" data-view="json">JSON</button>
                    </div>
                  </div>
                  <div class="view-content preview-view active">
                    <div class="modern-mockup-card tabular-mockup">
                      <div class="tab-row reference-row">
                        <span class="tab-name"
                          ><strong
                            >{
                              lang === "fr" ? "Farine T65" : "Bread Flour"
                            }</strong
                          > - 400g</span
                        >
                        <span class="tab-val tab-val-ref">100%</span>
                      </div>
                      <div class="tab-row reference-row">
                        <span class="tab-name"
                          ><strong
                            >{
                              lang === "fr" ? "Farine Complète" : "Whole Wheat"
                            }</strong
                          > - 100g</span
                        >
                        <span class="tab-val">25%</span>
                      </div>
                      <div class="tab-row">
                        <span class="tab-name"
                          ><strong>{lang === "fr" ? "Eau" : "Water"}</strong> - 375g</span
                        >
                        <span class="tab-val">75%</span>
                      </div>
                      <div class="tab-row">
                        <span class="tab-name"
                          ><strong>{lang === "fr" ? "Levain" : "Levain"}</strong
                          > - 100g</span
                        >
                        <span class="tab-val">20%</span>
                      </div>
                      <div class="tab-row">
                        <span class="tab-name"
                          ><strong>{lang === "fr" ? "Sel" : "Salt"}</strong> - 10g</span
                        >
                        <span class="tab-val">2%</span>
                      </div>
                    </div>
                  </div>
                  <div class="view-content json-view">
                    <div class="code-block json-block">
                      <Code
                        code={t.scaleOutput}
                        lang="json"
                        themes={codeThemes}
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div
        class="try-playground-container"
        style="text-align: center; margin-top: 3rem;"
      >
        <a href={lang === "fr" ? "/fr/play" : "/play"} class="button primary">
          {t.tryPlaygroundBtn || "Try it in the Playground"}
        </a>
      </div>
    </div>
  </section>

  <!-- Get Involved & Getting Started -->
  <section class="section get-involved alt-bg">
    <div class="homepage-container">
      <h2>{t.getInvolved}</h2>
      <div class="grid involved-grid">
        <div class="grid-item card">
          <h3>{t.readBookTitle}</h3>
          <p>
            {t.readBookDesc}
          </p>
          <a
            href={lang === "fr"
              ? "/fr/docs/explanation/philosophy"
              : "/docs/explanation/philosophy"}
            class="link-btn">{t.readBookLink} &rarr;</a
          >
        </div>
        <div class="grid-item card">
          <h3>{t.contributeTitle}</h3>
          <p>
            {t.contributeDesc}
          </p>
          <a href="https://codeberg.org/gram-lang/gram" class="link-btn"
            >{t.contributeLink} &rarr;</a
          >
        </div>
        <div class="grid-item card">
          <h3>{t.tryTitle}</h3>
          <p>
            {t.tryDesc}
          </p>
          <div class="terminal-mini">
            <code><span class="prompt">$</span> npx @gram-lang/cli init</code>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Modern Features Tabs and Preview/JSON toggles
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Feature Tabs Logic
    const tabBtns = document.querySelectorAll(".feature-tab-btn");
    const panels = document.querySelectorAll(".feature-panel");

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        tabBtns.forEach((b) => b.classList.remove("active"));
        panels.forEach((p) => p.classList.remove("active"));

        btn.classList.add("active");
        const targetId = btn.getAttribute("data-target");
        if (targetId) {
          const target = document.getElementById(targetId);
          if (target) target.classList.add("active");
        }
      });
    });

    // 2. Preview/JSON Toggle Logic
    const featurePanels = document.querySelectorAll(".feature-panel");
    featurePanels.forEach((panel) => {
      const toggleBtns = panel.querySelectorAll(".pill-btn");
      const viewContents = panel.querySelectorAll(".view-content");

      toggleBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          toggleBtns.forEach((b) => b.classList.remove("active"));
          viewContents.forEach((vc) => vc.classList.remove("active"));

          btn.classList.add("active");
          const viewType = btn.getAttribute("data-view");
          const targetView = panel.querySelector(`.${viewType}-view`);
          if (targetView) targetView.classList.add("active");
        });
      });
    });
  });
</script>

<style>
  /* Shiki Multi-theme hook for Starlight */
  :global(html[data-theme="dark"] .astro-code),
  :global(html[data-theme="dark"] .astro-code span) {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }

  /* Base Container */
  .section {
    padding: 5rem 1.5rem;
  }
  .alt-bg {
    background-color: var(--sl-color-bg-nav);
    border-top: 1px solid var(--sl-color-hairline);
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .homepage-container {
    max-width: 1152px;
    margin: 0 auto;
    font-family: var(--sl-font);
    color: var(--sl-color-text);
  }

  /* Typography & Basics */
  h1,
  h2,
  h3,
  h4 {
    color: var(--sl-color-white);
    font-weight: 800;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  h2 {
    font-size: 2.2rem;
    position: relative;
    margin-bottom: 0.75rem;
  }

  /* Subtle color accent on headers */
  /* h2::before {
    content: "";
    position: absolute;
    left: 0;
    top: 10%;
    height: 80%;
    width: 4px;
    background-color: var(--sl-color-accent-high, var(--sl-color-text-accent));
    border-radius: 2px;
  } */

  pre,
  code {
    font-family: var(--sl-font-mono);
    font-size: 0.9em;
  }

  /* Syntax Highlighting overrides for hero/tabs */
  .comment {
    color: var(--sl-color-gray-3);
  }
  .keyword {
    color: #ff7b72;
    font-weight: 500;
  }
  .tag {
    color: #79c0ff;
  }

  /* Hero Section */
  .hero-layout {
    display: flex;
    flex-wrap: wrap;
    gap: 4rem;
    align-items: center;
  }

  .hero-text {
    flex: 1 1 400px;
  }

  .version-badge {
    margin-top: 1rem;
  }
  .version-badge a {
    font-size: 1rem;
    font-weight: 600;
    font-family: var(--sl-font-mono);
    color: var(--sl-color-text-accent);
  }
  .version-badge a:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .title {
    font-size: 4.5rem;
    margin: 0 0 0.5rem 0;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.5rem;
    color: var(--sl-color-white);
    margin: 0 0 1rem 0;
    text-wrap: balance;
  }

  .description {
    font-size: 1.15rem;
    color: var(--sl-color-gray-3);
    margin: 0 0 2rem 0;
    line-height: 1.6;
    text-wrap: balance;
  }

  .actions {
    display: flex;
    gap: 1rem;
  }

  .button {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    text-decoration: none;
    font-weight: 600;
    border-radius: 4px;
    border: 1px solid transparent;
  }

  .button.primary {
    background-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .button.primary:hover {
    filter: brightness(1.1);
  }

  .button.secondary {
    background-color: transparent;
    color: var(--sl-color-white);
    border-color: var(--sl-color-hairline);
  }
  .button.secondary:hover {
    border-color: var(--sl-color-text-accent);
    background-color: var(--sl-color-bg-nav);
  }

  /* Code Block Styling */
  .hero-code {
    flex: 1 1 400px;
  }

  .code-block {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 10px;
    overflow: hidden;
    font-size: 1rem;
    box-shadow: var(--shadow-elevation-high);
  }

  .code-header {
    background-color: var(--sl-color-gray-7);
    border-bottom: 1px solid var(--sl-color-hairline);
    padding: 0.6rem 1rem;
  }

  .filename {
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    font-weight: bold;
  }

  .code-block pre {
    margin: 0;
    padding: 1.5rem;
    overflow-x: auto;
    color: var(--sl-color-gray-1);
    line-height: 1.5;
  }

  /* Grid Layouts */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 3rem;
  }

  .item-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
  }
  .item-header :global(.icon) {
    color: var(--sl-color-text-accent);
  }
  .grid-item h3 {
    font-size: 1.3rem;
    margin-bottom: 0;
  }
  .grid-item p {
    color: var(--sl-color-text);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .learn-more-link {
    display: inline-block;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .learn-more-link:hover {
    text-decoration: underline;
  }

  .philosophy h3 {
    margin-top: 0;
  }

  .section.philosophy {
    border-block-start: 10px solid var(--sl-color-accent);
  }

  /* Cards for Get Involved */

  .section.get-involved {
    background-color: var(--sl-color-accent);
