---
export interface Props {
	variant?: "header" | "footer";
}

const { variant = "header" } = Astro.props;
---

<div class:list={["social-links", variant]}>
  <a
    href="https://git.gram-lang.org/gram-lang/gram"
    title="Forgejo (Primary Repository)"
    target="_blank"
  >
    <!-- Forgejo / Git icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 48 48"
      width="20"
      height="20"
      ><defs
        ><clipPath id="a"><path d="M0 .113h91.887V92H0Zm0 0"></path></clipPath
        ></defs
      ><g
        stroke-width="2.552"
        clip-path="url(#a)"
        transform="translate(0 -.059)scale(.52238)"
        ><path
          fill="currentColor"
          d="M90.156 41.965 50.036 1.848a5.92 5.92 0 0 0-8.372 0l-8.328 8.332 10.566 10.566a7.03 7.03 0 0 1 7.23 1.684 7.03 7.03 0 0 1 1.669 7.277l10.187 10.184a7.03 7.03 0 0 1 7.278 1.672 7.04 7.04 0 0 1 0 9.957 7.05 7.05 0 0 1-9.965 0 7.04 7.04 0 0 1-1.528-7.66l-9.5-9.497V59.36a7.04 7.04 0 0 1 1.86 11.29 7.04 7.04 0 0 1-9.957 0 7.04 7.04 0 0 1 0-9.958 7.1 7.1 0 0 1 2.304-1.539V33.926a7.05 7.05 0 0 1-3.82-9.234l-10.418-10.42L1.73 41.777a5.925 5.925 0 0 0 0 8.371L41.852 90.27a5.925 5.925 0 0 0 8.37 0l39.934-39.934a5.925 5.925 0 0 0 0-8.371"
        ></path></g
      ></svg
    >
  </a>
  <a
    href="https://codeberg.org/gram-lang/gram"
    title="Codeberg Mirror"
    target="_blank"
  >
    <!-- Codeberg icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="currentColor"
      ><path
        d="M11.955.49A12 12 0 0 0 0 12.49a12 12 0 0 0 1.832 6.373L11.838 5.928a.187.14 0 0 1 .324 0l10.006 12.935A12 12 0 0 0 24 12.49a12 12 0 0 0-12-12zm.375 6.467 4.416 16.553a12 12 0 0 0 5.137-4.213z"
      ></path></svg
    >
  </a>
  <a
    href="https://github.com/gram-lang/gram"
    title="GitHub Mirror"
    target="_blank"
  >
    <!-- GitHub icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      xml:space="preserve"
      viewBox="0 0 512 512"
      height="20"
      width="20"
      ><path
        d="M256 6.3C114.6 6.3 0 120.9 0 262.3c0 113.3 73.3 209 175 242.9 12.8 2.2 17.6-5.4 17.6-12.2 0-6.1-.3-26.2-.3-47.7-64.3 11.8-81-15.7-86.1-30.1-2.9-7.4-15.4-30.1-26.2-36.2-9-4.8-21.8-16.6-.3-17 20.2-.3 34.6 18.6 39.4 26.2 23 38.7 59.8 27.8 74.6 21.1 2.2-16.6 9-27.8 16.3-34.2-57-6.4-116.5-28.5-116.5-126.4 0-27.8 9.9-50.9 26.2-68.8-2.6-6.4-11.5-32.6 2.6-67.8 0 0 21.4-6.7 70.4 26.2 20.5-5.8 42.2-8.6 64-8.6s43.5 2.9 64 8.6c49-33.3 70.4-26.2 70.4-26.2 14.1 35.2 5.1 61.4 2.6 67.8 16.3 17.9 26.2 40.6 26.2 68.8 0 98.2-59.8 120-116.8 126.4 9.3 8 17.3 23.4 17.3 47.4 0 34.2-.3 61.8-.3 70.4 0 6.7 4.8 14.7 17.6 12.2C438.7 471.3 512 375.3 512 262.3c0-141.4-114.6-256-256-256"
        style="fill-rule:evenodd;clip-rule:evenodd;fill:currentColor"
      ></path></svg
    >
  </a>
</div>

<style>
  .social-links {
    display: flex;
    gap: 0.35rem;
    align-items: center;
  }

  .social-links.header {
    color: var(--sl-color-gray-3);
  }
  .social-links.header a:hover {
    color: var(--sl-color-white);
  }

  .social-links.footer {
    color: white;
  }
  .social-links.footer a:hover {
    color: var(--sl-color-text-accent);
  }

  .social-links a {
    color: currentColor;
    display: flex;
    align-items: center;
    padding: 0.5rem;
    border-radius: 5px;
  }
</style>
