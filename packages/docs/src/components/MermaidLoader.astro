<script>
	function renderDiagrams() {
		const nodes = document.querySelectorAll<HTMLElement>(
			"pre.mermaid-diagram:not([data-rendered])",
		);
		if (nodes.length === 0) return;

		import("mermaid").then(({ default: mermaid }) => {
			const isDark = document.documentElement.dataset.theme === "dark";
			mermaid.initialize({
				startOnLoad: false,
				theme: isDark ? "dark" : "default",
			});

			nodes.forEach(async (node, i) => {
				node.dataset.rendered = "true";
				const source = node.textContent ?? "";
				try {
					const { svg } = await mermaid.render(`mermaid-${Date.now()}-${i}`, source);
					node.outerHTML = `<div class="mermaid-diagram">${svg}</div>`;
				} catch (err) {
					console.error("Mermaid render failed", err);
				}
			});
		});
	}

	renderDiagrams();
	document.addEventListener("astro:page-load", renderDiagrams);
</script>

<style is:global>
	pre.mermaid-diagram,
	div.mermaid-diagram {
		display: flex;
		justify-content: center;
		background: transparent;
	}
	pre.mermaid-diagram {
		visibility: hidden;
		height: 0;
		overflow: hidden;
	}
</style>
