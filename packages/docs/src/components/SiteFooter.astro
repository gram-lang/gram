---
import SocialLinks from "./SocialLinks.astro";

const { currentLang = "en" } = Astro.props;

const t = {
	en: {
		tagline: "An open-source markup language for recipes.",
		resources: "Resources",
		ecosystemTooling: "Ecosystem & Tooling",
		community: "Community",
		documentation: "Documentation",
		playground: "Playground",
		blog: "Blog",
		changelog: "Changelog",
		vscode: "VSCode Extension",
		cli: "CLI",
		languageServer: "Language Server",
		kitchenApi: "Kitchen API",
		reportIssue: "Report an Issue",
		contributing: "Contributing Guide",
		discord: "Discord",
		reddit: "Reddit",
		copyright:
			"© 2026 Gram Language. Proudly crafted in <a href='https://www.youtube.com/watch?v=P9Woz1g0jnM' target='_blank' class='easter-egg'>Rennes</a>, France 🇪🇺. Licensed under <a href='https://codeberg.org/gram-lang/gram/src/branch/main/LICENSE' target='_blank' class='license-link'>GPL-3.0</a>.",
	},
	fr: {
		tagline: "Un langage de balisage open-source pour vos recettes.",
		resources: "Ressources",
		ecosystemTooling: "Écosystème & Outils",
		community: "Communauté",
		documentation: "Documentation",
		playground: "Playground",
		blog: "Blog",
		changelog: "Changelog",
		vscode: "Extension VSCode",
		cli: "CLI",
		languageServer: "Serveur de langage (LSP)",
		kitchenApi: "API Kitchen",
		reportIssue: "Signaler un problème",
		contributing: "Guide de contribution",
		discord: "Discord",
		reddit: "Reddit",
		copyright:
			"© 2026 Gram Language. Fièrement conçu en <a href='https://www.youtube.com/watch?v=P9Woz1g0jnM' target='_blank' class='easter-egg'>Rennes</a>, France 🇪🇺. Sous licence <a href='https://codeberg.org/gram-lang/gram/src/branch/main/LICENSE' target='_blank' class='license-link'>GPL-3.0</a>.",
	},
};

const langText = t[currentLang as keyof typeof t] || t.en;
const prefix = currentLang === "fr" ? "/fr" : "";
---

<footer class="gram-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- Column 1: Brand -->
      <div class="footer-col brand-col">
        <a href={currentLang === "fr" ? "/fr/" : "/"} class="footer-logo">
          <img src="/logo.svg" alt="Gram Logo" />
          <span class="site-title">Gram</span>
        </a>
        <p class="tagline">{langText.tagline}</p>
        <div class="social-wrapper">
          <SocialLinks variant="footer" />
        </div>
      </div>

      <!-- Column 2: Resources -->
      <div class="footer-col">
        <h3>{langText.resources}</h3>
        <ul>
          <li>
            <a href={`${prefix}/docs/explanation/philosophy`}
              >{langText.documentation}</a
            >
          </li>
          <li><a href={`${prefix}/play`}>{langText.playground}</a></li>
          <li><a href={`${prefix}/blog`}>{langText.blog}</a></li>
          <li>
            <a href={`${prefix}/docs/changelog`}>{langText.changelog}</a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Ecosystem & Tooling -->
      <div class="footer-col">
        <h3>{langText.ecosystemTooling}</h3>
        <ul>
          <li>
            <a href={`${prefix}/docs/reference/tooling/vscode-extension`}
              >{langText.vscode}</a
            >
          </li>
          <li>
            <a href={`${prefix}/docs/reference/tooling/cli`}>{langText.cli}</a>
          </li>
          <li>
            <a href={`${prefix}/docs/reference/tooling/language-server`}
              >{langText.languageServer}</a
            >
          </li>
          <li>
            <a href={`${prefix}/docs/reference/api/kitchen`}
              >{langText.kitchenApi}</a
            >
          </li>
        </ul>
      </div>

      <!-- Column 4: Community -->
      <div class="footer-col">
        <h3>{langText.community}</h3>
        <ul>
          <li>
            <a
              href="https://git.gram-lang.org/gram-lang/gram/issues"
              target="_blank"
              rel="noopener">{langText.reportIssue}</a
            >
          </li>
          <li>
            <a
              href="https://git.gram-lang.org/gram-lang/gram/src/branch/main/CONTRIBUTING.md"
              target="_blank"
              rel="noopener">{langText.contributing}</a
            >
          </li>
          <li>
            <a
              href="https://discord.gg/nsCBkhjuAR"
              target="_blank"
              rel="noopener">{langText.discord}</a
            >
          </li>
          <li>
            <a
              href="https://www.reddit.com/r/gramlang/"
              target="_blank"
              rel="noopener">{langText.reddit}</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p set:html={langText.copyright} />
    </div>
  </div>
</footer>

<style>
  .gram-footer {
    background-color: hsl(30, 16%, 5%);
    padding: 4rem 1.5rem 1.5rem;
    color: hsl(30, 8%, 77%);
    font-family: var(--sl-font);
    margin-top: auto; /* Push to bottom if content is short */
  }

  .footer-container {
    max-width: 1152px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .brand-col {
      grid-column: 1 / -1;
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  .footer-col h3 {
    color: hsl(0, 0%, 100%);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    margin-top: 0;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-col a {
    color: hsl(30, 8%, 56%);
    font-size: 0.95rem;
  }

  .footer-col a:hover {
    color: var(--gram-orange, #ff5a00);
  }

  .brand-col .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: hsl(0, 0%, 100%);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .brand-col img {
    height: 2.2rem;
  }

  .brand-col .tagline {
    color: hsl(30, 8%, 56%);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
    max-width: 300px;
  }

  .footer-bottom {
    padding-top: 1.5rem;
    border-top: 1px solid hsl(30, 16%, 16%);
  }

  .footer-bottom p {
    color: hsl(30, 8%, 56%);
    font-size: 0.85rem;
    margin: 0;
  }

  :global(.easter-egg) {
    color: inherit !important;
    text-decoration: none !important;
    cursor: text !important;
  }

  :global(.license-link) {
    color: hsl(30, 8%, 56%);
  }

  :global(.license-link:hover) {
    color: var(--gram-orange, #ff5a00);
  }
</style>
