---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
  postHref: string;
  locale: "en" | "fr";
}

const { post, postHref, locale } = Astro.props;

function formatCardDate(date: Date, locale: "en" | "fr") {
  const month = date
    .toLocaleDateString(locale === "fr" ? "fr-FR" : "en-US", { month: "short" })
    .replace(/\.$/, "");
  return `${month.charAt(0).toUpperCase()}${month.slice(1)}. ${date.getDate()}`;
}
---

<article class="article-card">
  <a href={postHref} class="article-link">
    <time datetime={post.data.date.toISOString()} class="article-date">
      {formatCardDate(post.data.date, locale)}
    </time>
    <h2 class="article-title">{post.data.title}</h2>
  </a>
</article>

<style>
  .article-card {
    border-bottom: 1px solid var(--sl-color-border);
  }

  .article-card:last-child {
    border-bottom: none;
  }

  .article-link {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1rem;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s;
  }

  .article-link:hover {
    opacity: 0.8;
  }

  .article-date {
    font-size: 0.875rem;
    color: var(--sl-color-gray-4);
    white-space: nowrap;
  }

  .article-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: var(--sl-color-white);
  }
</style>
