---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { getTopicSlug } from "../data/blog-topics";

interface Props {
  post: CollectionEntry<"blog">;
  locale: "en" | "fr";
  basePath: string;
}

const { post, locale, basePath } = Astro.props;
const { Content } = await render(post);
const topicHref = `${basePath}/topic/${getTopicSlug(post.data.topic)}`;
---

<article class="blog-post-container">
  <header class="post-header">
    <h1>{post.data.title}</h1>
    <p class="post-meta">
      <time datetime={post.data.date.toISOString()}>
        {
          post.data.date.toLocaleDateString(
            locale === "fr" ? "fr-FR" : "en-US",
            {
              year: "numeric",
              month: "long",
              day: "numeric",
            },
          )
        }
      </time>
      <span class="meta-separator" aria-hidden="true">·</span>
      <a href={topicHref} class="post-topic">{post.data.topic}</a>
      <span class="meta-separator" aria-hidden="true">·</span>
      <span class="post-author">William</span>
    </p>
  </header>

  <div class="post-content">
    <Content />
  </div>
</article>

<style>
  .blog-post-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }

  .post-header {
    margin-bottom: 3rem;
    text-align: left;
  }

  .post-header h1 {
    font-size: 3rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    padding-bottom: 0.75rem;
    color: var(--sl-color-white);
    line-height: 1.2;
    border-bottom: 8px solid var(--sl-color-accent);
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    font-size: 1rem;
    color: var(--sl-color-gray-3);
  }

  .meta-separator {
    color: var(--sl-color-gray-3);
  }

  .post-topic {
    color: var(--sl-color-gray-3);
  }

  .post-topic:hover {
    color: var(--sl-color-accent);
  }

  /* Basic markdown styling matching the sober theme */
  .post-content {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--sl-color-text);
  }

  .post-content :global(h2) {
    font-size: 2rem;
    font-weight: 700;
    margin: 3rem 0 2rem 0;
    color: var(--sl-color-white);
    line-height: 1.3;
  }

  .post-content :global(h3) {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 2.5rem 0 1.5rem 0;
    color: var(--sl-color-white);
    line-height: 1.3;
  }

  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .post-content :global(a) {
    color: var(--sl-color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .post-content :global(a:hover) {
    color: var(--sl-color-accent-high);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 2rem 0;
    border: 1px solid var(--sl-color-hairline);
  }

  .post-content :global(pre) {
    padding: 1.5rem;
    border-radius: 8px;
    background-color: var(--sl-color-bg-inline-code);
    overflow-x: auto;
    margin: 2rem 0;
    border: 1px solid var(--sl-color-hairline);
  }

  .post-content :global(code) {
    font-family: var(--sl-font-mono);
    font-size: 0.9em;
    background-color: var(--sl-color-bg-inline-code);
    padding: 0.2em 0.4em;
    border-radius: 4px;
  }

  .post-content :global(pre code) {
    background-color: transparent;
    padding: 0;
    border-radius: 0;
  }

  .post-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    border-left: 4px solid var(--sl-color-accent);
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-3);
    border-radius: 0 8px 8px 0;
  }

  .post-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .blog-post-container {
      padding: 2rem 1rem;
    }

    .post-header {
      margin-bottom: 2rem;
    }

    .post-header h1 {
      font-size: 2rem;
      border-bottom-width: 4px;
    }

    .post-meta {
      font-size: 0.875rem;
    }

    .post-content {
      font-size: 1rem;
    }

    .post-content :global(h2) {
      font-size: 1.5rem;
      margin: 2rem 0 1.25rem 0;
    }

    .post-content :global(h3) {
      font-size: 1.25rem;
      margin: 1.5rem 0 1rem 0;
    }

    .post-content :global(pre) {
      padding: 1rem;
      margin: 1.5rem 0;
    }

    .post-content :global(blockquote) {
      margin: 1.5rem 0;
      padding: 0.75rem 1rem;
    }
  }
</style>
