---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { getTopicSlug } from "../../../data/blog-topics";
import { resolveLocalizedPosts } from "../../../lib/resolveLocalizedPosts";
import BlogListLayout from "../../../components/BlogListLayout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";

const allPosts = await getCollection("blog");
const postsToDisplay = resolveLocalizedPosts(allPosts, "fr");

// Sort by date descending
postsToDisplay.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const topics = [...new Set(postsToDisplay.map((post) => post.data.topic))];
---

<Layout title="Blog" description="Dernières nouveautés et articles autour du projet Gram." currentLang="fr">
  <BlogListLayout
    title="Blog"
    description="Dernières mises à jour, tutoriels et réflexions autour du projet Gram."
    basePath="/fr/blog"
    topics={topics}
    sidebarTitle="Sujets"
  >
    {postsToDisplay.length === 0 ? (
      <p>Aucun article pour le moment.</p>
    ) : (
      postsToDisplay.map(post => {
        // We use the english post slug for the URL to keep URLs consistent across languages
        // if we prefer, or we can use the specific post id. Let's use the clean slug.
        const slug = post.id.replace(/^(en|fr)\//, '').replace(/\.md$/, '');
        return (
          <ArticleCard
            post={post}
            postHref={`/fr/blog/${slug}`}
            topicHref={`/fr/blog/topic/${getTopicSlug(post.data.topic)}`}
            locale="fr"
          />
        );
      })
    )}
  </BlogListLayout>
</Layout>
