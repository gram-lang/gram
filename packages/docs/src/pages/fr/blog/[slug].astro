---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { resolveLocalizedPosts } from "../../../lib/resolveLocalizedPosts";
import BlogPostLayout from "../../../components/BlogPostLayout.astro";

export async function getStaticPaths() {
	const allPosts = await getCollection("blog");
	const postsToDisplay = resolveLocalizedPosts(allPosts, "fr");

	return postsToDisplay.map((post) => {
		const slug = post.id.replace(/^(en|fr)\//, "").replace(/\.md$/, "");
		return {
			params: { slug },
			props: { post },
		};
	});
}

const { post } = Astro.props;
---

<Layout title={post.data.title} description={post.data.description} currentLang="fr">
  <BlogPostLayout post={post} locale="fr" basePath="/fr/blog" />
</Layout>
