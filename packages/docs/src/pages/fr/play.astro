---
import Layout from "../../layouts/Layout.astro";
import GramPlayground from "../../components/playground/GramPlayground.vue";
---

<Layout
  title="Playground Gram"
  description="Écrivez des recettes Gram dans votre navigateur et visualisez en direct l'AST, le JSON compilé et le rendu final."
  currentLang="fr"
>
  <div class="playground-wrapper">
    <GramPlayground client:only="vue" lang="fr" />
  </div>
</Layout>

<style>
  .playground-wrapper {
    max-width: calc(1440px + 50px);
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    margin: 0 auto;
    padding: 1.5rem 25px;
    flex: 1;
    display: flex;
    flex-direction: column;
    /* Reserve the space GramPlayground.vue's .playground-workspace takes once
       hydrated, so the client:only island doesn't collapse to 0 height and
       shift the footer down when it mounts. */
    min-height: calc(100vh - 60px);
  }

  @media (max-width: 767px) {
    .playground-wrapper {
      min-height: calc(100dvh + 30px);
    }
  }
</style>
