---
import Layout from "../../layouts/Layout.astro";

const philosophy = [
	{
		title: "Texte Brut & Git",
		details:
			"Pas de base de données propriétaire ou d'enfermement. Vos recettes sont de simples fichiers texte qui peuvent être versionnés avec Git, partagés facilement et édités dans n'importe quel éditeur de texte.",
	},
	{
		title: "Évaluation Dynamique",
		details:
			"Arrêtez de calculer l'hydratation ou la taille des portions à la main. Le langage gère nativement les expressions arithmétiques, les déclarations de variables et les conversions d'unités.",
	},
	{
		title: "Outils Typés",
		details:
			"Propulsé par un serveur de langage dédié (LSP) qui vous offre des diagnostics en temps réel, une coloration sémantique et de l'autocomplétion directement dans votre IDE.",
	},
];
---

<Layout title="Gram" currentLang="fr">
  
  <!-- Hero Section -->
  <section class="section hero">
    <div class="homepage-container">
      <div class="hero-layout">
        <div class="hero-text">
          <div class="version-badge">
          <a href="/fr/docs/changelog">v1.0.0-beta.5</a>
        </div>
        <h1 class="title">Gram</h1>
        <p class="subtitle">Le langage de balisage open-source pour recettes.</p>
          <p class="description">Un langage en texte brut conçu pour la cuisine de précision, les calculs dynamiques et la mise à l'échelle des recettes.</p>
          
          <div class="actions">
            <a href="/fr/docs/explanation/philosophy" class="button primary">Démarrer</a>
            <a href="/fr/play" class="button secondary">Playground</a>
          </div>
        </div>
        
        <div class="hero-code">
          <div class="code-block">
            <div class="code-header">
              <span class="filename">pizza.gram</span>
            </div>
            <pre><code><span class="comment"># Pâte à Pizza (65% hydratation)</span>
<span class="keyword">@yield</span> 4 portions

= farine: 500g <span class="tag">[farine T65]</span>
= eau: {'{farine * 0.65}'} <span class="tag">[eau]</span>
= sel: {'{farine * 0.02}'} <span class="tag">[sel]</span>
= levure: 3g <span class="tag">[levure fraîche]</span>

1. Mélanger {'{farine}'} et {'{eau}'} 30m.
2. Ajouter {'{sel}'}, {'{levure}'}. Pétrir 10m.
3. Diviser en {'{yield}'}, pointer 24h.</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="section philosophy alt-bg">
    <div class="homepage-container">
      <h2>Pourquoi Gram ?</h2>
      <div class="grid">
        {philosophy.map(item => (
          <div class="grid-item">
            <h3>{item.title}</h3>
            <p>{item.details}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Use Cases with Vanilla Tabs -->
  <section class="section use-cases">
    <div class="homepage-container">
      <h2>Découvrir Gram</h2>
      <p class="section-desc">Découvrez comment Gram résout les problèmes courants de gestion culinaire.</p>
      
      <div class="tabs-container">
        <div class="tab-buttons">
          <button class="tab-btn active" data-target="tab-scale">Proportions</button>
          <button class="tab-btn" data-target="tab-nutrition">Base de Données</button>
          <button class="tab-btn" data-target="tab-schedule">Plannings</button>
        </div>
        
        <div class="tab-content active" id="tab-scale">
          <div class="two-pane">
            <div class="pane">
              <h4>Entrée</h4>
              <pre><code><span class="keyword">@yield</span> 2 portions

= farine: 250g
= eau: {'{farine * 0.65}'}</code></pre>
            </div>
            <div class="pane output">
              <h4>Résultat Évalué</h4>
              <pre><code>Rendement: 2 portions
farine: 250g
eau: 162.5g</code></pre>
            </div>
          </div>
        </div>
        
        <div class="tab-content" id="tab-nutrition">
          <div class="two-pane">
            <div class="pane">
              <h4>Entrée</h4>
              <pre><code><span class="comment"># Lier un ingrédient connu</span>
<span class="comment"># pour obtenir sa valeur nutritionnelle</span>
= sucre: 100g <span class="tag">[@sucre]</span></code></pre>
            </div>
            <div class="pane output">
              <h4>Résultat Évalué</h4>
              <pre><code>sucre: 100g
-> 387 kcal, 100g glucides</code></pre>
            </div>
          </div>
        </div>
        
        <div class="tab-content" id="tab-schedule">
          <div class="two-pane">
            <div class="pane">
              <h4>Entrée</h4>
              <pre><code>1. Repos pâte (2h)
2. Façonnage (15m)
3. Cuisson (45m)</code></pre>
            </div>
            <div class="pane output">
              <h4>Résultat Évalué</h4>
              <pre><code>Diagramme de Gantt généré:
Temps total: 3 heures
Temps actif: 15 minutes</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Get Involved & Getting Started -->
  <section class="section get-involved alt-bg">
    <div class="homepage-container">
      <h2>Participer & Essayer</h2>
      <div class="grid involved-grid">
        <div class="grid-item card">
          <h3>Lire le Livre</h3>
          <p>Apprenez à utiliser Gram de zéro. La documentation couvre tout, de la syntaxe de base à l'écriture de macros complexes et l'intégration de bases de données.</p>
          <a href="/fr/docs/explanation/philosophy" class="link-btn">Lire la documentation &rarr;</a>
        </div>
        <div class="grid-item card">
          <h3>Contribuer</h3>
          <p>Gram est open-source. Aidez-nous à améliorer le Language Server, à ajouter des fonctionnalités au CLI, ou à traduire la documentation.</p>
          <a href="https://codeberg.org/gram-lang/gram" class="link-btn">Voir sur Codeberg &rarr;</a>
        </div>
        <div class="grid-item card">
          <h3>Essayer instantanément</h3>
          <p>Vous pouvez initialiser un espace de travail via votre terminal sans rien installer de manière permanente.</p>
          <div class="terminal-mini">
            <code><span class="prompt">$</span> npx @gram-lang/cli init</code>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  // Simple vanilla tab logic
  document.addEventListener('DOMContentLoaded', () => {
    const btns = document.querySelectorAll('.tab-btn');
    const contents = document.querySelectorAll('.tab-content');
    
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Remove active class
        btns.forEach(b => b.classList.remove('active'));
        contents.forEach(c => c.classList.remove('active'));
        
        // Add active class
        btn.classList.add('active');
        const targetId = btn.getAttribute('data-target');
        if (targetId) {
          const target = document.getElementById(targetId);
          if (target) target.classList.add('active');
        }
      });
    });
  });
</script>

<style>
  /* Global */
  .section {
    padding: 5rem 1.5rem;
  }
  .alt-bg {
    background-color: var(--sl-color-bg-nav);
    border-top: 1px solid var(--sl-color-hairline);
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .homepage-container {
    max-width: 1000px;
    margin: 0 auto;
    font-family: var(--sl-font);
    color: var(--sl-color-text);
  }

  /* Typography & Basics */
  h1, h2, h3, h4 {
    color: var(--sl-color-white);
    font-weight: 600;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }
  
  h2 {
    font-size: 2.2rem;
    position: relative;
    padding-left: 1rem;
  }
  
  /* Subtle color accent on headers */
  h2::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10%;
    height: 80%;
    width: 4px;
    background-color: var(--sl-color-accent-high, var(--sl-color-text-accent));
    border-radius: 2px;
  }
  
  pre, code {
    font-family: var(--sl-font-mono);
    font-size: 0.9em;
  }

  /* Syntax Highlighting overrides for hero/tabs */
  .comment { color: var(--sl-color-gray-3); }
  .keyword { color: #ff7b72; font-weight: 500; }
  .tag { color: #79c0ff; }

  /* Hero Section */
  .hero-layout {
    display: flex;
    flex-wrap: wrap;
    gap: 4rem;
    align-items: center;
  }
  
  .hero-text {
    flex: 1 1 400px;
  }
  
  .version-badge {
    margin-bottom: 1rem;
  }
  .version-badge a {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    font-family: var(--sl-font-mono);
    color: var(--sl-color-accent-high, var(--sl-color-text-accent));
    background-color: rgba(255,255,255,0.05);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .version-badge a:hover {
    background-color: rgba(255,255,255,0.1);
  }

  .title {
    font-size: 4.5rem;
    margin: 0 0 0.5rem 0;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  
  .subtitle {
    font-size: 1.5rem;
    color: var(--sl-color-white);
    margin: 0 0 1rem 0;
  }
  
  .description {
    font-size: 1.15rem;
    color: var(--sl-color-text-accent);
    margin: 0 0 2rem 0;
    line-height: 1.6;
  }
  
  .actions {
    display: flex;
    gap: 1rem;
  }
  
  .button {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    text-decoration: none;
    font-weight: 600;
    border-radius: 4px;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }
  
  .button.primary {
    background-color: var(--sl-color-accent-high, var(--sl-color-white));
    color: var(--sl-color-black);
  }
  .button.primary:hover {
    filter: brightness(0.9);
  }
  
  .button.secondary {
    background-color: transparent;
    color: var(--sl-color-white);
    border-color: var(--sl-color-hairline);
  }
  .button.secondary:hover {
    border-color: var(--sl-color-text-accent);
    background-color: var(--sl-color-bg-nav);
  }

  /* Code Block Styling */
  .hero-code {
    flex: 1 1 400px;
  }
  
  .code-block {
    background-color: var(--sl-color-black);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }
  
  .code-header {
    background-color: #1a1a1a;
    border-bottom: 1px solid var(--sl-color-hairline);
    padding: 0.6rem 1rem;
  }
  
  .filename {
    color: var(--sl-color-text-accent);
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
  }
  
  .code-block pre {
    margin: 0;
    padding: 1.5rem;
    overflow-x: auto;
    color: var(--sl-color-gray-1);
    line-height: 1.5;
  }

  /* Grid Layouts */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 3rem;
  }
  .grid-item h3 {
    font-size: 1.3rem;
    margin-bottom: 0.8rem;
  }
  .grid-item p {
    color: var(--sl-color-text-accent);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  /* Cards for Get Involved */
  .card {
    background-color: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    padding: 2rem;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
  }
  .card p {
    flex-grow: 1;
  }
  .link-btn {
    display: inline-block;
    color: var(--sl-color-accent-high, var(--sl-color-white));
    text-decoration: none;
    font-weight: 500;
    margin-top: 1rem;
  }
  .link-btn:hover {
    text-decoration: underline;
  }

  /* Mini terminal */
  .terminal-mini {
    background-color: var(--sl-color-black);
    padding: 1rem;
    border-radius: 4px;
    border: 1px solid var(--sl-color-hairline);
    margin-top: 1rem;
  }
  .prompt {
    color: var(--sl-color-accent-high, var(--sl-color-text-accent));
    margin-right: 0.5rem;
  }

  /* Tabs Section */
  .section-desc {
    color: var(--sl-color-text-accent);
    margin-bottom: 3rem;
    font-size: 1.1rem;
  }
  
  .tabs-container {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 6px;
    overflow: hidden;
    background-color: var(--sl-color-black);
  }
  
  .tab-buttons {
    display: flex;
    background-color: #1a1a1a;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  
  .tab-btn {
    flex: 1;
    background: none;
    border: none;
    border-right: 1px solid var(--sl-color-hairline);
    padding: 1rem;
    color: var(--sl-color-text-accent);
    cursor: pointer;
    font-family: var(--sl-font);
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.2s;
  }
  
  .tab-btn:last-child {
    border-right: none;
  }
  
  .tab-btn:hover {
    background-color: var(--sl-color-bg-nav);
  }
  
  .tab-btn.active {
    background-color: var(--sl-color-black);
    color: var(--sl-color-white);
    border-bottom: 2px solid var(--sl-color-accent-high, var(--sl-color-white));
  }
  
  .tab-content {
    display: none;
  }
  
  .tab-content.active {
    display: block;
  }
  
  .two-pane {
    display: flex;
    flex-wrap: wrap;
  }
  
  .pane {
    flex: 1 1 50%;
    padding: 2rem;
  }
  
  .pane.output {
    background-color: rgba(255,255,255,0.03);
    border-left: 1px solid var(--sl-color-hairline);
  }
  
  @media (max-width: 600px) {
    .pane.output {
      border-left: none;
      border-top: 1px solid var(--sl-color-hairline);
    }
  }
  
  .pane h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-text-accent);
    margin: 0 0 1.5rem 0;
  }
  
  .pane pre {
    margin: 0;
    white-space: pre-wrap;
    color: var(--sl-color-gray-1);
    line-height: 1.5;
  }
</style>
