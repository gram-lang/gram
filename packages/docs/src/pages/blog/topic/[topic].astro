---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { getTopicSlug, getTopicInfo } from "../../../data/blog-topics";
import BlogListLayout from "../../../components/BlogListLayout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";

export async function getStaticPaths() {
	const allPosts = await getCollection("blog");
	const englishPosts = allPosts.filter((post) => post.data.locale === "en");

	// Get all unique topics from English posts
	const uniqueTopicsMap = new Map();
	englishPosts.forEach((post) => {
		const topic = post.data.topic;
		const slug = getTopicSlug(topic);
		if (!uniqueTopicsMap.has(slug)) {
			uniqueTopicsMap.set(slug, topic);
		}
	});

	const allTopicsList = Array.from(uniqueTopicsMap.values());

	return Array.from(uniqueTopicsMap.entries()).map(([slug, originalTopic]) => {
		const topicInfo = getTopicInfo(slug, originalTopic);

		// Filter posts for this topic
		const topicPosts = englishPosts.filter(
			(post) => getTopicSlug(post.data.topic) === slug,
		);

		// Sort by date descending, then by id descending (for releases on the same day)
		topicPosts.sort((a, b) => {
			const dateDiff = b.data.date.valueOf() - a.data.date.valueOf();
			if (dateDiff !== 0) return dateDiff;
			return b.id.localeCompare(a.id);
		});

		return {
			params: { topic: slug },
			props: {
				topicInfo,
				topicPosts,
				allTopics: allTopicsList,
			},
		};
	});
}

const { topicInfo, topicPosts, allTopics } = Astro.props;
---

<Layout title={`Topic: ${topicInfo.name.en}`} description={topicInfo.description.en} currentLang="en">
  <BlogListLayout
    title={topicInfo.name.en}
    description={topicInfo.description.en}
    backLink={{ href: "/blog", label: "← Back to all posts" }}
    basePath="/blog"
    topics={allTopics}
    activeTopicSlug={Astro.params.topic}
    topicsLabel="Topics"
  >
    {topicPosts.length === 0 ? (
      <p>No articles yet.</p>
    ) : (
      topicPosts.map(post => {
        const slug = post.id.replace(/^en\//, '').replace(/\.md$/, '');
        return (
          <ArticleCard
            post={post}
            postHref={`/blog/${slug}`}
            locale="en"
          />
        );
      })
    )}
  </BlogListLayout>
</Layout>
