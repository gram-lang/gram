---
// Redirect /docs to the first documentation page, automatically routing by browser language.
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content="0;url=/docs/explanation/philosophy" />
  <link rel="canonical" href="https://gram-lang.org/docs/explanation/philosophy" />
  <title>Redirecting to Gram Documentation...</title>
  <script is:inline>
    (function() {
      var lang = (navigator.language || navigator.userLanguage || "").toLowerCase();
      if (lang.startsWith("fr")) {
        window.location.replace("/fr/docs/explanation/philosophy");
      } else {
        window.location.replace("/docs/explanation/philosophy");
      }
    })();
  </script>
</head>
<body>
  <p>Redirecting to <a href="/docs/explanation/philosophy">Gram Documentation</a>...</p>
</body>
</html>
