{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "tsconfig.build.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "prebuild"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "prebuild": {
      "outputs": ["src/grammar-content.ts"],
      "outputLogs": "errors-only"
    },
    "@gram-lang/docs#prebuild": {
      "dependsOn": ["^build"],
      "outputs": ["public/llms-full.txt"],
      "outputLogs": "errors-only"
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputLogs": "errors-only"
    }
  }
}
