{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "tsconfig.build.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "prebuild"],
      "outputs": ["dist/**", "src/.vitepress/dist/**"]
    },
    "prebuild": {
      "outputs": ["src/grammar-content.ts"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"]
    }
  }
}
