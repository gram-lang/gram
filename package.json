{
  "name": "gram",
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@changesets/assemble-release-plan": "^6.0.10",
    "@changesets/cli": "^2.31.1",
    "@changesets/config": "^3.1.4",
    "@changesets/read": "^0.6.7",
    "@manypkg/get-packages": "^3.1.0",
    "tsup": "^8.5.1",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "license": "GPL-3.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "overrides": {
    "dompurify": "^3.4.12",
    "esbuild": "^0.28.1",
    "js-yaml": "^3.15.0",
    "fast-uri": "^4.1.2",
    "brace-expansion": "^5.0.9",
    "postcss": "^8.5.18",
    "linkify-it": "^5.0.0",
    "undici": "^7.29.0",
    "sharp": "^0.35.0"
  },
  "scripts": {
    "postinstall": "bun run build",
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@gram-lang/docs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "bun test",
    "change": "changeset",
    "version-packages": "bun run generate-release-note.ts && changeset version && bun update",
    "conformance": "bun run --cwd conformance conformance",
    "conformance:update": "bun run --cwd conformance conformance:update",
    "any-ratchet": "node scripts/any-ratchet.cjs",
    "any-ratchet:update": "node scripts/any-ratchet.cjs --update",
    "audit": "bun run --cwd audit audit",
    "ci": "bun run build && git diff --exit-code packages/parser/src/grammar-content.ts && bun run lint && bun run typecheck && bun run any-ratchet && bun test"
  },
  "workspaces": [
    "packages/*",
    "conformance",
    "audit"
  ]
}
