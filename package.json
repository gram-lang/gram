{
  "name": "gram",
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@changesets/assemble-release-plan": "^6.0.10",
    "@changesets/cli": "^2.31.0",
    "@changesets/config": "^3.1.4",
    "@changesets/read": "^0.6.7",
    "@manypkg/get-packages": "^3.1.0",
    "tsup": "^8.5.1",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "license": "GPL-3.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "overrides": {
    "dompurify": "^3.4.11",
    "vite": "^6.4.3",
    "esbuild": "^0.28.1",
    "js-yaml": "^3.15.0"
  },
  "scripts": {
    "postinstall": "bun run build",
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@gram-lang/docs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "bun test",
    "change": "changeset",
    "version-packages": "bun run generate-release-note.ts && changeset version && bun update",
    "conformance": "bun run --cwd conformance conformance",
    "conformance:update": "bun run --cwd conformance conformance:update"
  },
  "workspaces": [
    "packages/*",
    "conformance"
  ]
}